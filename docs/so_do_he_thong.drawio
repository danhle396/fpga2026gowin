          <mxGeometry x="40" y="10" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mc2" value="&lt;b&gt;Boot, runs once&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mc3" value="&lt;b&gt;Main loop, no RTOS&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="228" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mc4" value="&lt;b&gt;board.c&lt;/b&gt; board_init()&lt;br&gt;IHRC 48 MHz, SysTick 1 ms&lt;br&gt;UART0 115200 8N1&lt;br&gt;watchdog on" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc5" value="&lt;b&gt;imu.c&lt;/b&gt; imu_init()&lt;br&gt;WHO_AM_I = 0x68&lt;br&gt;write and read back 7 registers&lt;br&gt;fail → bus recovery, retry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="80" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc6" value="&lt;b&gt;gyro_cal.c&lt;/b&gt;&lt;br&gt;200 samples at rest (2 s)&lt;br&gt;span &amp;gt; 100 LSB → restart" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="80" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc7" value="&lt;b&gt;MPU6050&lt;/b&gt;&lt;br&gt;6 axes, 100 Hz&lt;br&gt;±16 g · ±2000 °/s&lt;br&gt;DLPF 44 Hz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc8" value="&lt;b&gt;i2c0.c&lt;/b&gt; i2c0_read()&lt;br&gt;I²C 400 kHz, polled&lt;br&gt;P0.10 SCL · P0.11 SDA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc9" value="&lt;b&gt;imu.c&lt;/b&gt;&lt;br&gt;polls INT_STATUS 0x3A (≤ 1/ms)&lt;br&gt;imu_read(): 14 B from 0x3B&lt;br&gt;drops TEMP → 6 INT16" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc10" value="&lt;b&gt;app_main.c&lt;/b&gt;&lt;br&gt;subtract gyro offset, saturate&lt;br&gt;gap ≥ 15 ms counted as lost" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc11" value="&lt;b&gt;node_link.c&lt;/b&gt;&lt;br&gt;node_pack_sample()&lt;br&gt;F1 7E · SEQ · LEN · 'D' · 6 INT16&lt;br&gt;keys · CRC-16 = 21 B" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc12" value="&lt;b&gt;board.c&lt;/b&gt; uart_putc()&lt;br&gt;waits for THRE, no interrupt&lt;br&gt;P3.1 → ESP32 GPIO16&lt;br&gt;≈ 1.8 ms per frame" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="260" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc13" value="&lt;b&gt;ESP32 hub&lt;/b&gt;&lt;br&gt;RX GPIO16: sample frames&lt;br&gt;TX GPIO17: buzzer commands" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1360" y="260" width="190" height="280" as="geometry" />
        </mxCell>
        <mxCell id="mc14" value="&lt;b&gt;app_main.c — imu_lam_lai()&lt;/b&gt;&lt;br&gt;i2c0_bus_recover(): 9 SCL pulses + STOP&lt;br&gt;then i2c0_init() and imu_init(), retry every 1 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="430" width="410" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mc15" value="&lt;b&gt;board.c&lt;/b&gt; keys_scan()&lt;br&gt;every 10 ms&lt;br&gt;20 ms debounce" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mc16" value="&lt;b&gt;app_main.c&lt;/b&gt;&lt;br&gt;0xB0 / 0xB1: off / on&lt;br&gt;0xC0 + k: tone type&lt;br&gt;no command &amp;gt; 500 ms → off" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="430" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mc17" value="&lt;b&gt;board.c&lt;/b&gt; uart_getc()&lt;br&gt;polled every pass&lt;br&gt;P3.2 ← ESP32 GPIO17" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="430" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="mc18" value="&lt;b&gt;Also in the loop&lt;/b&gt; (app_main.c)&lt;br&gt;watchdog fed every pass · LED D6 (P3.8) 1 Hz&lt;br&gt;STAT text line every 5 s on the same UART" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="620" width="410" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc19" value="&lt;b&gt;Interrupts&lt;/b&gt; (board.c)&lt;br&gt;SysTick 1 ms: time base&lt;br&gt;CT16B0: buzzer tone&lt;br&gt;sensor, I²C, UART are polled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="620" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc20" value="&lt;b&gt;board.c&lt;/b&gt; board_buzzer()&lt;br&gt;CT16B0 MR0 = 11,999 → 2 kHz&lt;br&gt;ISR toggles P3.0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="920" y="620" width="190" height="95" as="geometry" />
        </mxCell>
        <mxCell id="mc21" value="&lt;b&gt;Buzzer PZ1&lt;/b&gt;&lt;br&gt;2 kHz on P3.0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="620" width="190" height="95" as="geometry" />
