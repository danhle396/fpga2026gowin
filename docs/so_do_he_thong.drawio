ometry"/></mxCell><mxCell id="ov22" value="Bộ đệm cửa sổ 768 × 8 (BSRAM)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="275" width="280" height="40" as="geometry"/></mxCell><mxCell id="ov23" value="&lt;b&gt;1D-CNN N2 INT8 — RTL tự viết&lt;/b&gt; (engine E2)&lt;br&gt;3 × Conv1D + Dense 512→4&lt;br&gt;5,15 ms / cửa sổ @ 50,143 MHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="325" width="280" height="75" as="geometry"/></mxCell><mxCell id="ov24" value="Khung kết quả 7 B&lt;br&gt;(0x5A · SEQ · STATUS · CLASS · SCORE · CRC-16)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="410" width="280" height="55" as="geometry"/></mxCell><mxCell id="ov25" value="Nguồn clock: dao động 27 MHz → rPLL 50,143 MHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1260" y="475" width="280" height="35" as="geometry"/></mxCell><mxCell id="ov26" value="&lt;b&gt;Điện thoại / laptop&lt;/b&gt; (cùng WiFi)&lt;br&gt;http://&amp;lt;IP ESP32&amp;gt;/&lt;br&gt;trạng thái · tư thế · CNN · biểu đồ · thống kê · sự kiện · nút Hủy / Bật lại" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="690" width="260" height="100" as="geometry"/></mxCell><mxCell id="ov27" value="&lt;b&gt;PC ghi log&lt;/b&gt;&lt;br&gt;tools/ghi_uart.py, logger.py&lt;br&gt;USB 460800 hoặc TCP 3333" style="rounded=1;whiteSp