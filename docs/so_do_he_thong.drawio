11;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=0.2;entryY=0;" edge="1" parent="1" source="fp11" target="fp29"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="541" y="610"/><mxPoint x="1056" y="610"/></Array></mxGeometry></mxCell><mxCell id="fp42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;endArrow=none;dashed=1;" edge="1" parent="1" source="fp29" target="fp30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fp29" target="fp31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fp31" target="fp6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp45" value="IRQ cao khi có khung&lt;br&gt;(không dùng)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#bbbbbb;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="fp29" target="fp7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1056" y="885"/></Array></mxGeometry></mxCell><mxCell id="fp46" value="&lt;b&gt;Tài nguyên sau P&amp;amp;R&lt;/b&gt; (Gowin EDA V1.9.11.03):&lt;br&gt;Logic 8 % · BSRAM 18 % · DSP 10 % · Fmax 111,01 MHz&lt;br&gt;RTL và netlist sau P&amp;amp;R khớp golden_model.py từng bit (tb_e2, tb_proto, gl.sh)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1040" y="930" width="520" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sm" name="5. Safety FSM + xác nhận ngã"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sm1" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Safety FSM (SPEC A.8) và xác nhận ngã thật (A.12)&lt;/b&gt;&lt;br&gt;Mỗi khe 10 ms. Ưu tiên: CANCEL &amp;gt; timeout &amp;gt; phiếu CNN &amp;gt; khối. Tên trên web ghi trong ngoặc." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="60" as="geometry"/></mxCell><mxCell id="sm2" value="STANDBY&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(TẮT)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#eeeeee;strokeColor=#bbbbbb;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="170" height="90" as="geometry"/></mxCell><mxCell id="sm3" value="MONITOR&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(ĐANG THEO DÕI)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="380" width="190" height="90" as="geometry"/></mxCell><mxCell id="sm4" value="SUSPECT&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(PHÁT HIỆN NGÃ)&lt;br&gt;còi 400 ms / s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="380" width="190" height="90" as="geometry"/></mxCell><mxCell id="sm5" value="PRE_ALARM&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(CẢNH BÁO)&lt;br&gt;2 bíp / s, đếm 10 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="380" width="190" height="90" as="geometry"/></mxCell><mxCell id="sm6" value="ALARM&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(BÁO ĐỘNG)&lt;br&gt;còi hú 350/500 ms&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="sm7" value="COOLDOWN&lt;br&gt;&lt;span style=&#x27;font-weight:normal&#x27;&gt;(tạm nghỉ 30 s)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#eeeeee;strokeColor=#bbbbbb;verticalAlign=middle;align=center;spacing=6;fontSize=12;ellipse;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="sm8" value="TẮT (nhấn nhanh 2 lần)&lt;br&gt;liên tục 3 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.3;" edge="1" parent="1" source="sm3" target="sm2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm9" value="BẬT (giữ 2 s /&lt;br&gt;web Bật lại)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.7;" edge="1" parent="1" source="sm2" target="sm3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm10" value="fall_votes ≥ 2/3&lt;br&gt;và BẬT trong 3 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sm3" target="sm4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm11" value="still_run ≥ 8 khối (2,56 s)&lt;br&gt;và |az_tb| &amp;lt; 1450&lt;br&gt;(ngực lệch 45°–135°)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sm4" target="sm5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm12" value="A.12 loại · hoặc quá 8 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm4" target="sm3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="300"/><mxPoint x="495" y="300"/></Array></mxGeometry></mxCell><mxCell id="sm13" value="CANCEL · hoặc A.12 loại" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.3;entryY=0;" edge="1" parent="1" source="sm5" target="sm3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="220"/><mxPoint x="457" y="220"/></Array></mxGeometry></mxCell><mxCell id="sm14" value="hết 10 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sm5" target="sm6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm15" value="giữ CANCEL 3 s (SOS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0.95;entryX=0;entryY=0.15;" edge="1" parent="1" source="sm3" target="sm6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="600"/><mxPoint x="1120" y="600"/><mxPoint x="1120" y="713"/></Array></mxGeometry></mxCell><mxCell id="sm16" value="SOS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="sm4" target="sm6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="727"/></Array></mxGeometry></mxCell><mxCell id="sm17" value="giữ CANCEL 1 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="sm6" target="sm7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm18" value="sau 30 s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="sm7" target="sm3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sm19" value="&lt;b&gt;A.12 — xác nhận ngã thật&lt;/b&gt; (nga.c, chạy khi vào SUSPECT)&lt;hr align=&#x27;left&#x27;&gt;1. &lt;b&gt;Trước đó thẳng&lt;/b&gt;: có khối hướng THẲNG 3,2–10,2 s trước SUSPECT&lt;br&gt;2. &lt;b&gt;Va chạm&lt;/b&gt;: đỉnh |a| ≥ 2,5 g (5120 LSB) trong 12 khối gần nhất&lt;br&gt;3. &lt;b&gt;Quay nhanh&lt;/b&gt;: đỉnh |ω| ≥ 220 °/s trong ±5 khối quanh khối va chạm&lt;br&gt;4. &lt;b&gt;Ngực nghiêng&lt;/b&gt; ≥ 45° trong 12 khối sau va chạm&lt;br&gt;&lt;br&gt;Đủ cả 4 → XÁC NHẬN · thiếu một hoặc quá 4 s → LOẠI (safety_bo_nghi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="120" width="420" height="210" as="geometry"/></mxCell><mxCell id="sm20" value="&lt;b&gt;Hiển thị và còi&lt;/b&gt; (hub_coi)&lt;br&gt;Chưa xác nhận ngã thật → còi im, web hiện MONITOR.&lt;br&gt;ALARM do SOS luôn kêu. Âm 2 kHz cố định (COI_KIEU_CHOT)." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1460" y="360" width="420" height="90" as="geometry"/></mxCell><mxCell id="sm21" value="&lt;b&gt;MẤT CẢM BIẾN&lt;/b&gt; (ngoài FSM)&lt;br&gt;&amp;gt; 3 s không có mẫu → web đỏ, 2 bíp mỗi 3 s, LED nháy nhanh." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1460" y="480" width="420" height="70" as="geometry"/></mxCell><mxCell id="sm22" value="&lt;b&gt;Tham số&lt;/b&gt; (fw_config.h)&lt;br&gt;T_STILL_A / T_STILL_G = 300 / 250 LSB · STILL_BLOCKS = 8&lt;br&gt;T_TILT = 1450 LSB · VOTE_K / VOTE_N = 2 / 3&lt;br&gt;SUSPECT_TIMEOUT 8 s · PRE_ALARM_TIME 10 s · COOLDOWN 30 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1460" y="580" width="420" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="dv" name="6. Mô hình → phần cứng &amp; kiểm chứng"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dv1" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Từ dữ liệu tới bitstream, và chuỗi kiểm chứng không cần board&lt;/b&gt;&lt;br&gt;golden_model.py là đáp án; mọi tầng được kiểm khớp từng bit trước khi lên board" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="60" as="geometry"/></mxCell><mxCell id="dv2" value="&lt;b&gt;SPEC v3.4&lt;/b&gt;&lt;br&gt;Phụ lục A của PROJECT_MASTER.md&lt;br&gt;(docs/spec.md sinh bằng sync_spec.py)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="300" height="70" as="geometry"/></mxCell><mxCell id="dv3" value="&lt;b&gt;D1&lt;/b&gt; UCI #455 (Özdemir &amp;amp; Barshan)&lt;br&gt;11 người, kênh đầu 340540" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="220" height="70" as="geometry"/></mxCell><mxCell id="dv4" value="tools/convert_d1.py&lt;br&gt;25 → 50 Hz, INT8 theo A.2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="200" height="70" as="geometry"/></mxCell><mxCell id="dv5" value="ml/train_cnn.py --arch n2&lt;br&gt;(numpy, LOSO)&lt;br&gt;Macro-F1 0,983" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;f