ryY=0.5;" edge="1" parent="1" source="fp20" target="fp21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fp21" target="fp22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1425" y="418"/><mxPoint x="1095" y="418"/></Array></mxGeometry></mxCell><mxCell id="fp27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fp22" target="fp23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp28" value="requant: acc ≤ 0 → 0, ngược lại min(acc ≫ n, 127) · không làm tròn&lt;br&gt;258.080 chu kỳ = 5,15 ms / cửa sổ · bộ đếm CYCLES 24 bit" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1020" y="258" width="490" height="50" as="geometry"/></mxCell><mxCell id="fp29" value="&lt;b&gt;result_frame_v3.v&lt;/b&gt;&lt;br&gt;0x5A · SEQ · STATUS · CLASS · SCORE · CRC-16&lt;br&gt;+ 4 logit · CYCLES · CRC (đuôi HIL)&lt;br&gt;một bộ đệm kết quả" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="280" height="95" as="geometry"/></mxCell><mxCell id="fp30" value="crc16_ccitt.v" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1150" y="770" width="140" height="40" as="geometry"/></mxCell><mxCell id="fp31" value="&lt;b&gt;spi_result_tx_v3.v&lt;/b&gt;&lt;br&gt;dịch khung ra MISO&lt;br&gt;chốt &#x27;có kết quả&#x27; khi CS xuống&lt;br&gt;chưa có → MISO = 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="760" width="250" height="95" as="geometry"/></mxCell><mxCell id="fp32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fp3" target="fp8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fp4" target="fp9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fp5" target="fp10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp35" value="byte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="fp10" target="fp11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fp36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=