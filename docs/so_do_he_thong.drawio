        <mxCell id="wr56" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Chỉ nạp &lt;b&gt;fpga/bitstream/fpga_project.fs&lt;/b&gt;: CS, SCK, MOSI chỉ là đầu vào, MISO là đầu ra → không tranh dây với ESP32.&lt;br&gt;• SPI: mode 0, MSB trước, 1 MHz (lùi 100 kHz nếu dây dài); RTL cho phép ≤ 4 MHz.&lt;br&gt;• MPU6050 treo → web báo MẤT CẢM BIẾN; rút pin ≈ 5 s rồi cắm lại.&lt;br&gt;• VDD của EVK phải 3,3 V (SW1 ON, jumper J1/J3) trước khi nối dây.&lt;br&gt;• Nối GND trước, dây tín hiệu ≤ 15 cm." vertex="1">
          <mxGeometry height="150" width="560" x="1180" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="es" name="3. ESP32 processing flow">
    <mxGraphModel dx="1625" dy="967" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="es1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" value="&lt;b style=&quot;font-size:20px&quot;&gt;ESP32 processing flow&lt;/b&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="60" width="1400" x="40" y="10" as="geometry" />
        </mxCell>
        <mxCell id="es2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;UART2 RX&lt;/b&gt;&lt;br&gt;GPIO16, 115200&lt;br&gt;from MCU" vertex="1">
          <mxGeometry height="95" width="190" x="40" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;node_link.c&lt;/b&gt;&lt;br&gt;parses F1 7E frames, CRC-16&lt;br&gt;resyncs after a bad frame&lt;br&gt;fills lost samples ≤ 50 (in .ino)" vertex="1">
          <mxGeometry height="95" width="190" x="260" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;Axis map + offset&lt;/b&gt; (hub.c)&lt;br&gt;X = +Zc, Y = −Xc, Z = −Yc&lt;br&gt;subtract ACC_OFF (204, −3, −4)" vertex="1">
          <mxGeometry height="95" width="190" x="480" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;preprocess.c&lt;/b&gt; (A.2)&lt;br&gt;filter (1,3,3,1)/8, ↓ 50 Hz&lt;br&gt;INT8: acc ≫ 7, gyro ≫ 6" vertex="1">
          <mxGeometry height="95" width="190" x="700" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;Window&lt;/b&gt; (A.3)&lt;br&gt;ring 128 × 6 (2.56 s)&lt;br&gt;every 16 samples (0.32 s)&lt;br&gt;i = t × 6 + c" vertex="1">
          <mxGeometry height="95" width="190" x="920" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;spi_frame.c&lt;/b&gt; (A.7)&lt;br&gt;A5 · SEQ · 768 B · CRC-16&lt;br&gt;= 772 B, one CS low period" vertex="1">
          <mxGeometry height="95" width="190" x="1140" y="200" as="geometry" />
        </mxCell>
        <mxCell id="es8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;" value="&lt;b&gt;Kiwi FPGA&lt;/b&gt;&lt;br&gt;CNN N2 INT8&lt;br&gt;5.15 ms" vertex="1">
