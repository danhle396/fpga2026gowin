<mxfile host="app.diagrams.net" agent="Claude Code" version="24.7.17"><diagram id="ov" name="1. Tổng quan hệ thống"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ov1" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Thiết bị đeo ngực phát hiện té ngã — VKU-NewBie&lt;/b&gt;&lt;br&gt;Sơ đồ khối và luồng dữ liệu bản chốt 28/10/2026 (SPEC v3.4, Phụ lục A của PROJECT_MASTER.md)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell><mxCell id="ov2" value="&lt;b&gt;MPU6050&lt;/b&gt; (dây đeo ngực)&lt;hr&gt;6 trục, 100 Hz&lt;br&gt;±16 g · ±2000 °/s&lt;br&gt;DLPF 44 Hz · I²C 0x68" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="210" height="130" as="geometry"/></mxCell><mxCell id="ov3" value="&lt;b&gt;Nút duy nhất (SW3 trên EVK)&lt;/b&gt;&lt;br&gt;BẬT/TẮT · HỦY · SOS" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="210" height="70" as="geometry"/></mxCell><mxCell id="ov4" value="SN32F407 EVK&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:12px&#x27;&gt;Cortex-M0, 48 MHz · firmware/keil/fw.uvprojx (FW_NODE 1)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;verticalAlign=top;align=center;fontStyle=1;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="300" height="380" as="geometry"/></mxCell><mxCell id="ov5" value="Đọc MPU6050 100 Hz (ngắt data-ready)&lt;br&gt;Hiệu chuẩn offset gyro lúc khởi động" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="210" width="260" height="55" as="geometry"/></mxCell><mxCell id="ov6" value="Quá 200 ms không có mẫu → gỡ bus I²C,&lt;br&gt;cấu hình lại cảm biến mỗi giây · watchdog" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="275" width="260" height="55" as="geometry"/></mxCell><mxCell id="ov7" value="Đóng khung mẫu &lt;b&gt;F1 7E&lt;/b&gt; 21 B&lt;br&gt;(6 trục + nút, CRC-16) → UART0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="340" width="260" height="55" as="geometry"/></mxCell><mxCell id="ov8" value="Nhận lệnh còi 1 B → âm 2 kHz trên PZ1&lt;br&gt;(mất lệnh &amp;gt; 0,5 s thì tự tắt còi)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="405" width="260" height="55" as="geometry"/></mxCell><mxCell id="ov9" value="&lt;b&gt;Còi PZ1&lt;/b&gt; (EVK)&lt;br&gt;2 kHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="580" width="200" height="60" as="geometry"/></mxCell><mxCell id="ov10" value="ESP32 DevKit — bộ xử lý trung tâm&lt;br&gt;&lt;span style=&#x27;font-weight:normal;font-size:12px&#x27;&gt;esp32/mu_nga_hub (lõi C chép từ firmware/src)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b