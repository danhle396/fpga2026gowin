        <mxCell id="sm19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;fontSize=12;" value="&lt;b&gt;A.12 — xác nhận ngã thật&lt;/b&gt; (nga.c, chạy khi vào SUSPECT)&lt;hr align=&#39;left&#39;&gt;1. &lt;b&gt;Trước đó thẳng&lt;/b&gt;: có khối hướng THẲNG 3,2–10,2 s trước SUSPECT&lt;br&gt;2. &lt;b&gt;Va chạm&lt;/b&gt;: đỉnh |a| ≥ 2,5 g (5120 LSB) trong 12 khối gần nhất&lt;br&gt;3. &lt;b&gt;Quay nhanh&lt;/b&gt;: đỉnh |ω| ≥ 220 °/s trong ±5 khối quanh khối va chạm&lt;br&gt;4. &lt;b&gt;Ngực nghiêng&lt;/b&gt; ≥ 45° trong 12 khối sau va chạm&lt;br&gt;&lt;br&gt;Đủ cả 4 → XÁC NHẬN · thiếu một hoặc quá 4 s → LOẠI (safety_bo_nghi)" vertex="1">
          <mxGeometry height="210" width="420" x="1460" y="120" as="geometry" />
        </mxCell>
        <mxCell id="sm20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" value="&lt;b&gt;Hiển thị và còi&lt;/b&gt; (hub_coi)&lt;br&gt;Chưa xác nhận ngã thật → còi im, web hiện MONITOR.&lt;br&gt;ALARM do SOS luôn kêu. Âm 2 kHz cố định (COI_KIEU_CHOT)." vertex="1">
          <mxGeometry height="90" width="420" x="1460" y="360" as="geometry" />
        </mxCell>
        <mxCell id="sm21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" value="&lt;b&gt;MẤT CẢM BIẾN&lt;/b&gt; (ngoài FSM)&lt;br&gt;&amp;gt; 3 s không có mẫu → web đỏ, 2 bíp mỗi 3 s, LED nháy nhanh." vertex="1">
          <mxGeometry height="70" width="420" x="1460" y="480" as="geometry" />
        </mxCell>
        <mxCell id="sm22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#ffffff;strokeColor=#999999;verticalAlign=middle;align=center;spacing=6;fontSize=12;align=left;verticalAlign=top;" value="&lt;b&gt;Tham số&lt;/b&gt; (fw_config.h)&lt;br&gt;T_STILL_A / T_STILL_G = 300 / 250 LSB · STILL_BLOCKS = 8&lt;br&gt;T_TILT = 1450 LSB · VOTE_K / VOTE_N = 2 / 3&lt;br&gt;SUSPECT_TIMEOUT 8 s · PRE_ALARM_TIME 10 s · COOLDOWN 30 s" vertex="1">
          <mxGeometry height="100" width="420" x="1460" y="580" as="geometry" />
        </mxCell>
      </root>
