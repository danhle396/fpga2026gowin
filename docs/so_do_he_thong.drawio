et="wr13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="214"/><mxPoint x="30" y="578"/></Array></mxGeometry></mxCell><mxCell id="wr47" value="I²C SDA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr6" target="wr14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="248"/><mxPoint x="20" y="612"/></Array></mxGeometry></mxCell><mxCell id="wr48" value="UART: mẫu 100 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr10" target="wr28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="476"/><mxPoint x="470" y="384"/></Array></mxGeometry></mxCell><mxCell id="wr49" value="UART: lệnh còi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="wr29" target="wr11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="418"/><mxPoint x="560" y="510"/></Array></mxGeometry></mxCell><mxCell id="wr50" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr12" target="wr30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="544"/><mxPoint x="600" y="452"/></Array></mxGeometry></mxCell><mxCell id="wr51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr23" target="wr36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wr52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr24" target="wr37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wr53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr25" target="wr38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wr54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="wr39" target="wr26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wr55" value="GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="wr27" target="wr40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wr56" value="&lt;b&gt;Ghi chú&lt;/b&gt;&lt;br&gt;• Chỉ nạp &lt;b&gt;fpga/bitstream/fpga_project.fs&lt;/b&gt;: CS, SCK, MOSI chỉ là đầu vào, MISO là đầu ra → không tranh dây với ESP32.&lt;br&gt;• SPI: mode 0, MSB trước, 1 MHz (lùi 100 kHz nếu dây dài); RTL cho phép ≤ 4 MHz.&lt;br&gt;• MPU6050 treo → web báo MẤT CẢM BIẾN; rút pin ≈ 5 s rồi cắm lại.&lt;br&gt;• VDD của EVK phải 3,3 V (SW1 ON, jumper J1/J3) trước khi nối dây.&lt;br&gt;• Nối GND trước, dây tín hiệu ≤ 15 cm." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1180" y="520" width="560" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="es" name="3. Luồng xử lý trên ESP32"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="es1" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Luồng xử lý trên ESP32 (esp32/mu_nga_hub · hub.c → app_core)&lt;/b&gt;&lt;br&gt;Mẫu thô 100 Hz trục người dùng cho khối/tư thế/xác nhận ngã; mẫu 50 Hz INT8 dùng cho CNN trên FPGA" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="60" as="geometry"/></mxCell><mxCell id="es2" value="&lt;b&gt;UART2 RX&lt;/b&gt;&lt;br&gt;GPIO16, 115200&lt;br&gt;từ MCU (FW_NODE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es3" value="&lt;b&gt;node_link.c&lt;/b&gt;&lt;br&gt;tách khung F1 7E, CRC-16&lt;br&gt;dò lại đầu khung khi hỏng&lt;br&gt;chèn bù mẫu mất ≤ 50" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es4" value="&lt;b&gt;Đổi trục + offset&lt;/b&gt; (hub.c)&lt;br&gt;X = +Zc, Y = −Xc, Z = −Yc&lt;br&gt;trừ ACC_OFF (204, −3, −4)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es5" value="&lt;b&gt;preprocess.c&lt;/b&gt; (A.2)&lt;br&gt;lọc (1,3,3,1)/8, ↓ 50 Hz&lt;br&gt;INT8: acc ≫ 7, gyro ≫ 6" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es6" value="&lt;b&gt;Cửa sổ&lt;/b&gt; (A.3)&lt;br&gt;ring 128 × 6 (2,56 s)&lt;br&gt;mỗi 16 mẫu (0,32 s)&lt;br&gt;i = t × 6 + c" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es7" value="&lt;b&gt;spi_frame.c&lt;/b&gt; (A.7)&lt;br&gt;A5 · SEQ · 768 B · CRC-16&lt;br&gt;= 772 B, CS thấp 1 lần" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1140" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es8" value="&lt;b&gt;FPGA Kiwi&lt;/b&gt;&lt;br&gt;CNN N2 INT8&lt;br&gt;5,15 ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="190" height="95" as="geometry"/></mxCell><mxCell id="es9" value="&lt;b&gt;Tự kiểm khi bật nguồn&lt;/b&gt; (A.10)&lt;br&gt;payload LFSR 0xB400 / 0xACE1, SEQ 0xEE&lt;br&gt;so với selftest_expect_v3_e2_n2.h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="80" width="410" height="70" as="geometry"/></mxCell><mxCell id="es10" value="&lt;b&gt;Đọc kết quả&lt;/b&gt; (hỏi vòng)&lt;br&gt;5A · SEQ · STATUS · CLASS · SCORE · CRC&lt;br&gt;STATUS ≠ 0x01, SEQ lệch → bỏ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="380" width="190" height="110" as="geometry"/></mxCell><mxCell id="es11" value="&lt;b&gt;Bỏ phiếu&lt;/b&gt;&lt;br&gt;fall_votes = số cửa sổ FALL&lt;br&gt;trong 3 gần nhất (SCORE ≥ T_SCORE)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="380" width="190" height="110" as="geometry"/></mxCell><mxCell id="es12" value="&lt;b&gt;blocks.c&lt;/b&gt; (A.8)&lt;br&gt;khối 32 mẫu thô (0,32 s)&lt;br&gt;bất động: max−min &amp;lt; 300 / 250 LSB&lt;br&gt;still_run, az_tb" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="380" width="190" height="110" as="geometry"/></mxCell><mxCell id="es13" value="&lt;b&gt;safety.c — Safety FSM&lt;/b&gt; (A.8)&lt;br&gt;STANDBY · MONITOR · SUSPECT&lt;br&gt;PRE_ALARM · ALARM · COOLDOWN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="380" width="300" height="110" as="geometry"/></mxCell><mxCell id="es14" value="&lt;b&gt;nga.c — xác nhận ngã thật&lt;/b&gt; (A.12)&lt;br&gt;1 trước đó thẳng · 2 va chạm ≥ 2,5 g&lt;br&gt;3 quay ≥ 220 °/s · 4 nghiêng ≥ 45°&lt;br&gt;thiếu 1 → safety_bo_nghi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="560" width="300" height="110" as="geometry"/></mxCell><mxCell id="es15" value="&lt;b&gt;posture.c&lt;/b&gt; (A.11, chỉ hiển thị)&lt;br&gt;ĐỨNG · NGỒI · NẰM ngửa/sấp/nghiêng&lt;br&gt;CÚI · ĐANG DI CHUYỂN" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="560" width="230" height="110" as="geometry"/></mxCell><mxCell id="es16" value="&lt;b&gt;pwr_btn.c&lt;/b&gt;&lt;br&gt;BẬT (giữ 2 s) · TẮT (nhấn 2 lần)&lt;br&gt;HỦY · SOS (giữ 3 s)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="560" width="190" height="110" as="geometry"/></mxCell><mxCell id="es17" value="Nút SW3 (bit trong khung mẫu)&lt;br&gt;Nút BOOT GPIO0&lt;br&gt;Nút Hủy / Bật lại trên web" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1360" y="560" width="190" height="110" as="geometry"/></mxCell><mxCell id="es18" value="&lt;b&gt;MẤT CẢM BIẾN&lt;/b&gt;&lt;br&gt;&amp;gt; 3 s không có mẫu&lt;br&gt;web đỏ, 2 bíp / 3 s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="190" height="110" as="geometry"/></mxCell><mxCell id="es19" value="&lt;b&gt;hub_coi / hub_ten_trang_thai&lt;/b&gt;&lt;br&gt;còi chỉ kêu khi đã xác nhận ngã thật (SOS luôn kêu)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="760" width="300" height="80" as="geometry"/></mxCell><mxCell id="es20" value="Lệnh còi 1 B&lt;br&gt;GPIO17 → MCU → PZ1 2 kHz" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="230" height="80" as="geometry"/></mxCell><mxCell id="es21" value="LED GPIO2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="860" width="230" height="40" as="geometry"/></mxCell><mxCell id="es22" value="&lt;b&gt;Trang web&lt;/b&gt; HTTP&lt;br&gt;trạng thái, tư thế, CNN, biểu đồ,&lt;br&gt;thống kê, sự kiện" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="760" width="210" height="80" as="geometry"/></mxCell><mxCell id="es23" value="&lt;b&gt;Log&lt;/b&gt; USB 460800&lt;br&gt;+ WiFi TCP 3333&lt;br&gt;(dòng N, P, STAT…)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=middle;align=center;spacing=6;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1390" y="760" width="180" height="80" as="geometry"/></mxCell><mxCell id="es24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es2" target="es3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es3" target="es4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es4" target="es5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es5" target="es6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es6" target="es7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es29" value="SPI ghi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="es7" target="es8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="es9" target="es7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="es31" value="SPI đọc 7 B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;ortho