ry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov38" value="log USB / TCP 3333" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.6;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ov10" target="ov27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ov10" target="ov28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ov40" value="nguồn 3,3 V + GND" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="ov10" target="ov2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="90"/><mxPoint x="145" y="90"/></Array></mxGeometry></mxCell><mxCell id="ov41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.3;entryY=1;dashed=1;" edge="1" parent="1" source="ov29" target="ov4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="550"/><mxPoint x="420" y="550"/></Array></mxGeometry></mxCell><mxCell id="ov42" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;━ dữ liệu &amp;nbsp; &lt;font color=&#x27;#b85450&#x27;&gt;━&lt;/font&gt; còi / báo động &amp;nbsp; &lt;font color=&#x27;#d79b00&#x27;&gt;┅&lt;/font&gt; nguồn &amp;nbsp; &lt;font color=&#x27;#666666&#x27;&gt;━&lt;/font&gt; giao diện&lt;br&gt;IRQ (J2-24) và RST_N (J2-23) của FPGA không nối: ESP32 hỏi vòng kết quả.&lt;br&gt;GND chung giữa MCU – ESP32 – Kiwi – MPU6050." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="790" width="520" height="90" as="geometry"/></mxCell><mxCell id="ov43" value="&lt;b&gt;Kết quả chốt 28/10&lt;/b&gt;&lt;br&gt;• LOSO D1 11 người (cảm biến ở đầu): Macro-F1 0,983&lt;br&gt;• Log đeo ngực: ngồi phịch báo nhầm 0/10, ngã lên nệm 14/15, tư thế 9/9&lt;br&gt;• FPGA: logic 8 %, BSRAM 18 %, DSP 10 %, Fmax 111,01 MHz&lt;br&gt;• Không báo theo thiết kế: ngã kết thúc quỳ / ngồi mà thân vẫn thẳng" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="620" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="wr" name="2. Nối dây (chân)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="wr1" value="&lt;b style=&#x27;font-size:20px&#x27;&gt;Nối dây phần cứng (cố định theo sơ đồ của nhóm, 24–28/10)&lt;/b&gt;&lt;br&gt;Logic 3,3 V. Nguồn: Phụ lục E, esp32/mu_nga_hub/mu_nga_hub.ino, docs/huong_dan_nap_chay.md" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="60" as="geometry"/></mxCell><mxCell id="wr2" value="MPU6050 (dây đeo ngực)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=middle;align=center;spacing=6;fontSize=12;verticalAlign=top;align=center;fontStyle=1;fontSize=14;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="260" height="254" as="geometry"/></mxCell><mxCell id="wr3" value="VCC" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAl