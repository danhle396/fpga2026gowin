<?xml version="1.0" encoding="utf-8"?>

<package schemaVersion="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:noNamespaceSchemaLocation="PACK.xsd">
  <vendor>SONiX</vendor>
  <url>https://liveupdate.sonix.com.tw/sonix/develop_tool/MCU/DFP/</url>
  <name>SN32F4_DFP</name>
  <description>SONiX SN32F4 Series Device Support and Examples</description>

  <releases>
    <release version="1.1.2" date="2026-05-20">
      1. Add SN32F420 related files
    </release>
  	<release version="1.1.1" date="2025-06-12">
      1. Update SN32F400.svd and SN32F400.h
    </release>
	<release version="1.1.0" date="2025-03-31">
      1. Update ROM size.
    </release>
	<release version="1.0.2" date="2024-12-17">
      1. Update startup_SN32F400.s to v1.0.3 (add test mode disable)
    </release>
	<release version="1.0.1" date="2024-09-25">
      1. Update SN32F400.svd and SN32F400.h
      2. Update system_SN32F400.c
    </release>
    <release version="1.0.0" date="2024-04-10">
      1. Update SN32F400.svd and SN32F400.h
      2. Update system_SN32F400.c
    </release>
     <release version="0.0.19" date="2023-12-12">
      1. Update SN32F400.svd and SN32F400.h
      2. Update system_SN32F400.c
    </release>
    <release version="0.0.18" date="2023-09-18">
      1. Update SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.17" date="2023-06-01">
      1. Update SN32F400.svd and SN32F400.h
          - Remove SYS1_APBCP0 register.
    </release>
    <release version="0.0.16" date="2023-05-15">
      1. Update SN32F400.svd and SN32F400.h
          - Update PLL control register bits.
	  - Update LVD voltage level descriptions.
	  - Update ADC registers.
    </release>
    <release version="0.0.15" date="2023-02-02">
      1. Update SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.14" date="2023-01-13">
      1. Update SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.13" date="2023-01-10">
      1. Update SN32F400.svd and SN32F400.h
         - Add SWREBOOTF bit
         - Remove ADCPRE bits
         - Separate IHRCEN[1:0] bits to IHRCEN bit and IHRCFREQ bit
    </release>
    <release version="0.0.12" date="2022-12-21">
      1. Update startup_SN32F400.s to v1.0.1
    </release>
    <release version="0.0.11" date="2022-12-20">
      1. Add FOCPRE bits in SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.10" date="2022-12-07">
      1. Update GPIO IP Control FPGA Status registers in SN32F400.svd and SN32F400.h
      2. Update CT16B0 BRKDB bit description in SN32F400.svd
      3. Update FOC/ACC registers in SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.9" date="2022-11-28">
      1. Update OPA/FOC/ACC registers in SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.8" date="2022-11-22">
      1. Update SN32F400.svd and SN32F400.h
      2. Update SN32F400_32.FLM
    </release>
    <release version="0.0.7" date="2022-11-17">
      Update SN32F400.svd and SN32F400.h
      1. Add FOC related registers.
      2. Change CT16B0 BRKIF and BRKIC to bit 31 of CT16B0_RIS and CT16B0_IC register
    </release>
    <release version="0.0.6" date="2022-11-02">
      1. Change attribute of SYS1_PRST register to WO in SN32F400.svd and SN32F400.h 
    </release>
    <release version="0.0.5" date="2022-10-07">
      1. Add I2C Setup Time register in SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.4" date="2022-09-12">
      1. Update SN32F400_32.FLM
      2. Update SN32F400.svd
    </release>
    <release version="0.0.3" date="2022-08-10">
      Update SN32F400.svd and SN32F400.h
      1. Update description of CT16Bn_LOADCTRL bit Enumerated Values.
      2. Update PFPA register name: I2C to I2C0, SPI to SPI0
      3. Update CT Clock Select register (SYS0_CT_CLKSEL)
      4. Modify SN_DMA module name to SN_DMA0
    </release>
    <release version="0.0.2" date="2022-07-26">
      Update SN32F400.svd and SN32F400.h
    </release>
    <release version="0.0.1" date="2022-03-24">
      First Release version of SN32F4 Device Family Pack.
    </release>
  </releases>

  <keywords>
    <!-- keywords for indexing -->
    <keyword>SONiX</keyword>
    <keyword>Device Support</keyword>
    <keyword>Device Family Package SONiX</keyword>
    <keyword>SN32F4</keyword>
    <keyword>SN32F4xx</keyword>
    <keyword>SN32F40x</keyword>
	<keyword>SN32F42x</keyword>
    <keyword>SN32</keyword>
  </keywords>

  <devices>
    <!-- generated, do not modify this section! -->

    <family Dfamily="SN32F4 Series" Dvendor="SONiX:110">
      <processor Dcore="Cortex-M0" DcoreVersion="r0p0" Dfpu="0" Dmpu="0" Dendian="Little-endian"/>
      <book name="Documents/dui0497a_cortex_m0_r0p0_generic_ug.pdf" title="Cortex-M0 Generic User Guide"/>
        <description>
SN32F4 series 32-bit micro-controller is a new series of extremely Low Power Consumption and High Performance MCU powered by ARM Cortex M0 processor with Flash ROM architecture.
        </description>

      <!-- ************************  Subfamily 'SN32F400'  **************************** -->
      <subFamily DsubFamily="SN32F400">
      	<processor Dclock="60000000"/>
        <compile header="Device/Include/SN32F400.h"  define="SN32F400"/>
        <debug      svd="SVD/SN32F400.svd"/>
        <memory     id="IROM1"                      start="0x00000000"  size="0x7FFC"	startup="1"	default="1"/>
        <memory     id="IRAM1"                      start="0x20000000"  size="0x2000"	init   ="0"	default="1"/>
        <algorithm  name="Flash/SN32F400_32.FLM"   start="0x00000000"  size="0x8000"	RAMstart="0x20000000"	RAMsize="0x2000"	default="1"/>
        <feature type="VCC"           n="1.80"    m="5.50"/>
        <feature type="Timer"         n="3"       m="16"/>
        <feature type="WDT"           n="1"/>
        <feature type="RTC"           n="1"/>
        <feature type="I2C"           n="1"/>
        <feature type="SPI"           n="1"/>
        <feature type="UART"          n="2"/>
	    <feature type="ExtInt"        n="4"/>
        <feature type="Other"         n="4"                           name="CMP"/>
        <feature type="Other"         n="3"                           name="OPA"/>
        <feature type="Other"         n="5"                           name="DMA"/>
        <feature type="Other"         n="1"                           name="CRC"/>

      <!-- *************************  Device 'SN32F407F'  ***************************** -->
      <device Dname="SN32F407F">
        <feature type="IOs"           n="46"/>
        <feature type="ADC"           n="16"	m="12"/>
        <feature type="PWM"           n="16"/>
        <feature type="QFP"           n="48"/>
      </device>
      <!-- *************************  Device 'SN32F405F'  ***************************** -->
      <device Dname="SN32F405F">
        <feature type="IOs"           n="30"/>
        <feature type="ADC"           n="16"	m="12"/>
        <feature type="PWM"           n="16"/>
        <feature type="QFP"           n="32"/>
      </device>
	  <!-- *************************  Device 'SN32F405J'  ***************************** -->
      <device Dname="SN32F405J">
        <feature type="IOs"           n="30"/>
        <feature type="ADC"           n="16"	m="12"/>
        <feature type="PWM"           n="16"/>
        <feature type="QFN"           n="32"/>
      </device>
	  <!-- *************************  Device 'SN32F403J'  ***************************** -->
      <device Dname="SN32F403J">
        <feature type="IOs"           n="23"/>
        <feature type="ADC"           n="16"	m="12"/>
        <feature type="PWM"           n="16"/>
        <feature type="QFN"           n="24"/>
      </device>
      </subFamily>
	  
	  <!-- ************************  Subfamily 'SN32F420'  **************************** -->
      <subFamily DsubFamily="SN32F420">
      	<processor Dclock="48000000"/>
        <compile header="Device/Include/SN32F420.h"  define="SN32F420"/>
        <debug      svd="SVD/SN32F420.svd"/>
        <memory     id="IROM1"                      start="0x00000000"  size="0x7FC0"	startup="1"	default="1"/>
        <memory     id="IRAM1"                      start="0x20000000"  size="0x1000"	init   ="0"	default="1"/>
        <algorithm  name="Flash/SN32F420_32.FLM"   start="0x00000000"  size="0x8000"	RAMstart="0x20000000"	RAMsize="0x1000"	default="1"/>
        <feature type="VCC"           n="2.50"    m="5.50"/>
        <feature type="Timer"         n="3"       m="16"/>
        <feature type="WDT"           n="1"/>
        <feature type="RTC"           n="1"/>
        <feature type="I2C"           n="1"/>
        <feature type="SPI"           n="1"/>
        <feature type="UART"          n="2"/>
	    <feature type="ExtInt"        n="4"/>
        <feature type="Other"         n="2"                           name="CMP"/>
        <feature type="Other"         n="1"                           name="HALL"/>
        <feature type="Other"         n="1"                           name="ACC"/>
        <feature type="Other"         n="1"                           name="OPA"/>
        <feature type="Other"         n="4"                           name="DMA"/>
        <feature type="Other"         n="1"                           name="CRC"/>

      <!-- *************************  Device 'SN32F424T'  ***************************** -->
      <device Dname="SN32F424T">
        <feature type="IOs"           n="26"/>
        <feature type="ADC"           n="17"	m="12"/>
        <feature type="PWM"           n="12"/>
        <feature type="TSSOP"           n="28"/>
      </device>
	  <!-- *************************  Device 'SN32F423J'  ***************************** -->
      <device Dname="SN32F423J">
        <feature type="IOs"           n="22"/>
        <feature type="ADC"           n="15"	m="12"/>
        <feature type="PWM"           n="12"/>
        <feature type="QFN"           n="24"/>
      </device>
      </subFamily>
	  
    </family>
  </devices>

  <conditions>
    <!-- Compiler Conditions -->
    <condition id="Compiler ARM">
      <require Tcompiler="ARMCC"/>
    </condition>
    
    <!-- Device Conditions -->
    <condition id="SN32F40">
      <description>SONiX SN32F400 Series devices</description>
      <accept Dvendor="SONiX:110" Dname="SN32F40??*"/>
    </condition>
	
	<condition id="SN32F42">
      <description>SONiX SN32F420 Series devices</description>
      <accept Dvendor="SONiX:110" Dname="SN32F42??*"/>
    </condition>

    <!-- Device + CMSIS Conditions -->
    <condition id="SN32F40 CMSIS Device">
      <description>SONiX SN32F400 series Devices and CMSIS-Core</description>
      <require condition="SN32F40"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
	
	<condition id="SN32F42 CMSIS Device">
      <description>SONiX SN32F420 series Devices and CMSIS-Core</description>
      <require condition="SN32F42"/>
      <require Cclass="CMSIS" Cgroup="CORE"/>
    </condition>
	
  </conditions>


  <boards>
    <board vendor="SONiX" name="SN32F400 Starter Kit Rev1_0" revision="v1.0" salesContact="sales@sonix.com.tw" orderForm="http://www.sonix.com.tw/article-en-1019-4193#">
      <description>SONiX SN32F400 Starter Kit</description>
      <book category="schematic" name="Documents/SN32F400_STARTKIT_V1.0.pdf" title="Schematics"/>
      <mountedDevice    deviceIndex="0" Dvendor="SONiX:110" Dname="SN32F40*"/>
      <compatibleDevice deviceIndex="0" Dvendor="SONiX:110" Dfamily="SN32F400"/>
      <feature type="PWR"       n="5"              name="USB Powered"/>
      <feature type="Button"    n="4"              name="Push-buttons: User and Reset"/>
      <feature type="RS232"     n="1"              name="DB9 Female Connector"/>
      <feature type="DIO"       n="26"             name="Digital IOs (shared with Analog IOs)"/>
      <feature type="LED"       n="3"              name="LEDs: Two user, one PWR LED"/>
      <feature type="ConnOther" n="1"              name="JTAG Interface"/>
    </board>
	
	<board vendor="SONiX" name="SN32F420 Starter Kit Rev1_0" revision="v1.0" salesContact="sales@sonix.com.tw" orderForm="http://www.sonix.com.tw/article-en-1019-4193#">
      <description>SONiX SN32F420 Starter Kit</description>
      <book category="schematic" name="Documents/SN32F420_STARTKIT_V1.0.pdf" title="Schematics"/>
      <mountedDevice    deviceIndex="0" Dvendor="SONiX:110" Dname="SN32F42*"/>
      <compatibleDevice deviceIndex="0" Dvendor="SONiX:110" Dfamily="SN32F420"/>
      <feature type="PWR"       n="5"              name="USB Powered"/>
      <feature type="Button"    n="3"              name="Push-buttons: User and Reset"/>
      <feature type="RS232"     n="1"              name="DB9 Female Connector"/>
      <feature type="DIO"       n="26"             name="Digital IOs (shared with Analog IOs)"/>
      <feature type="LED"       n="3"              name="LEDs: Two user, one PWR LED"/>
      <feature type="ConnOther" n="1"              name="JTAG Interface"/>
    </board>
	
  </boards>

  <examples>
    <example name="CMSIS-RTOS Blinky" doc="Abstract.txt" folder="Boards/SONiX/SN32F400 Starter Kit Rev1_0/RTX_Blinky">
      <description>CMSIS-RTOS based Blinky example</description>
      <board name="SN32F400 Starter Kit Rev1_0" vendor="SONiX" Dvendor="SONiX:110"/>
      <project>
        <environment name="uv" load="Blinky.uvprojx"/>
      </project>
      <attributes>
        <component Cclass="CMSIS" Cgroup="CORE"/>
        <component Cclass="Device" Cgroup="Startup"/>
        <component Cclass="CMSIS" Cgroup="RTOS"/>
        <category>Getting Started</category>
        <category>CMSIS-RTX</category>
      </attributes>
    </example>
	
	<example name="CMSIS-RTOS Blinky" doc="Abstract.txt" folder="Boards/SONiX/SN32F420 Starter Kit Rev1_0/RTX_Blinky">
      <description>CMSIS-RTOS based Blinky example</description>
      <board name="SN32F420 Starter Kit Rev1_0" vendor="SONiX" Dvendor="SONiX:110"/>
      <project>
        <environment name="uv" load="Blinky.uvprojx"/>
      </project>
      <attributes>
        <component Cclass="CMSIS" Cgroup="CORE"/>
        <component Cclass="Device" Cgroup="Startup"/>
        <component Cclass="CMSIS" Cgroup="RTOS"/>
        <category>Getting Started</category>
        <category>CMSIS-RTX</category>
      </attributes>
    </example>
	
  </examples>

  <components>       
    <!-- Startup SN32F40 -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.1" condition="SN32F40 CMSIS Device">
      <!-- Cversion is necessary -->
      <description>System Startup for SONiX SN32F400 Series</description>
      <files>
        <file category="include"	name="Device/Include/"/>
        <file category="sourceAsm"	name="Device/Source/ARM/startup_SN32F400.s"   attr="config"    version="1.0.3"	condition="Compiler ARM"/>
        <file category="sourceC"	name="Device/Source/system_SN32F400.c"        attr="config"    version="1.0.1"/>
      </files>
    </component>
	
	<!-- Startup SN32F42 -->
    <component Cclass="Device" Cgroup="Startup" Cversion="1.0.0" condition="SN32F42 CMSIS Device">
      <!-- Cversion is necessary -->
      <description>System Startup for SONiX SN32F420 Series</description>
      <files>
        <file category="include"	name="Device/Include/"/>
        <file category="sourceAsm"	name="Device/Source/ARM/startup_SN32F420.s"   attr="config"    version="1.0.3"	condition="Compiler ARM"/>
        <file category="sourceC"	name="Device/Source/system_SN32F420.c"        attr="config"    version="1.0.6"/>
      </files>
    </component>
	
  </components>
</package>
