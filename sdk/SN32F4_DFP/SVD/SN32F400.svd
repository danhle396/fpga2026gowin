                </enumeratedValue>
                <enumeratedValue>
                  <name>Start</name>
                  <description>Start ADC calibration</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCCR</name>
