    <!-- SN_WDT -->
    <peripheral>
      <name>SN_WDT</name>
      <version>1.0</version>
      <description>Watchdog Timer</description>
      <groupName>WDT</groupName>
      <baseAddress>0x40010000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>WDT</name>
        <description>Watchdog Timer</description>
        <value>25</value>
      </interrupt>
      
      <registers>
        <!-- SN_WDT_CFG -->
        <register>
          <name>CFG</name>
          <description>Offset:0x00 WDT Configuration register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0007</resetMask>
          
          <fields>
            <field>
              <name>WDTEN</name>
              <description>WDT enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable WDT</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable WDT</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTIE</name>
              <description>WDT interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>WDT reset when WDT time-out</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable WDT interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTINT</name>
              <description>WDT interrupt flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No WDT time-out</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDT time-out</name>
                  <description>WDT interrupt is triggered if WDTIE=1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDKEY</name>
              <description>WDT register key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_WDT_TC -->
        <register>
          <name>TC</name>
          <description>Offset:0x08 WDT Timer Constant register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000FF</resetValue>
          <resetMask>0xFFFF00FF</resetMask>
          
          <fields>
            <field>
              <name>TC</name>
              <description>Watchdog timer constant reload value</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>WDKEY</name>
              <description>WDT register key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_WDT_FEED -->
        <register>
          <name>FEED</name>
          <description>Offset:0x0C WDT Feed register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>FV</name>
              <description>Watchdog feed value</description>
              <bitRange>[15:0]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>WDKEY</name>
              <description>WDT register key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_RTC -->
    <peripheral>
      <name>SN_RTC</name>
      <version>1.0</version>
      <description>Real-time Clock</description>
      <groupName>RTC</groupName>
      <baseAddress>0x40012000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>RTC</name>
        <description>Real-time Clock</description>
        <value>23</value>
      </interrupt>
      
      <registers>
        <!-- SN_RTC_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x00 RTC Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>RTCEN</name>
              <description>RTC enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable RTC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable RTC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_CLKS -->
        <register>
          <name>CLKS</name>
          <description>Offset:0x04 RTC Clock Source register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>CLKSEL</name>
              <description>RTC clock source</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ILRC</name>
                  <description>RTC clock source=ILRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ELS XTAL</name>
                  <description>RTC clock source=ELS XTAL</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_IE -->
        <register>
          <name>IE</name>
          <description>Offset:0x08 RTC Interrupt Enable register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>SECIE</name>
              <description>Second interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable second interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable second interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_RIS -->
        <register>
          <name>RIS</name>
          <description>Offset:0x0C RTC Raw Interrupt Status register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>SECIF</name>
              <description>Second interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No second interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met</name>
                  <description>Second interrupt is triggered when SECIE=1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_IC -->
        <register>
          <name>IC</name>
          <description>Offset:0x10 RTC Interrupt Clear register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>SECIC</name>
              <description>Second interrupt flag clear</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>Clear second interrupt flag</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_SECCNTV -->
        <register>
          <name>SECCNTV</name>
          <description>Offset:0x14 RTC Second Counter Reload Value register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00008000</resetValue>
          <resetMask>0x000FFFFF</resetMask>
          
          <fields>
            <field>
              <name>SECCNTV</name>
              <description>RTC Second Counter Reload value</description>
              <bitRange>[19:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_RTC_SECCNT -->
        <register>
          <name>SECCNT</name>
          <description>Offset:0x18 RTC Second Counter register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>SECCNT</name>
              <description>RTC Second counter</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_UART0 -->
    <peripheral>
      <name>SN_UART0</name>
      <version>1.0</version>
      <description>UART0</description>
      <groupName>UART</groupName>
      <baseAddress>0x40016000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>UART0</name>
        <description>UART0 interrupt</description>
        <value>13</value>
      </interrupt>
      
      <registers>
        <!-- SN_UART0_RB -->
        <register>
          <name>RB</name>
          <description>Offset:0x00 UARTn Receiver Buffer register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>RB</name>
              <description>The received byte</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_TH -->
        <register>
          <name>TH</name>
          <description>Offset:0x00 UARTn Transmit Holding register</description>
          <alternateRegister>RB</alternateRegister>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>TH</name>
              <description>The byte to be transmitted when transmitter is available</description>
              <bitRange>[7:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_DLL -->
        <register>
          <name>DLL</name>
          <description>Offset:0x00 UARTn Divisor Latch LSB register</description>
          <alternateRegister>RB</alternateRegister>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>DLL</name>
              <description>DLL and DLM register determines the baud rate of UARTn</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_DLM -->
        <register>
          <name>DLM</name>
          <description>Offset:0x04 UARTn Divisor Latch MSB register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>DLM</name>
              <description>DLL and DLM register determines the baud rate of UARTn</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_IE -->
        <register>
          <name>IE</name>
          <description>Offset:0x04 UARTn Interrupt Enable register</description>
          <alternateRegister>DLM</alternateRegister>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000017</resetMask>
          
          <fields>
            <field>
              <name>RDAIE</name>
              <description>RDA interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable RDA interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable RDA interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>THREIE</name>
              <description>THRE interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable THRE interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable THRE interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RLSIE</name>
              <description>RLS interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable RLS interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable RLS interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TEMTIE</name>
              <description>TEMT interrupt enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable TEMT interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable TEMT interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_II -->
        <register>
          <name>II</name>
          <description>Offset:0x08 UARTn Interrupt Identification register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000041</resetValue>
          <resetMask>0x000000CF</resetMask>
          
          <fields>
            <field>
              <name>INTSTATUS</name>
              <description>Interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Pending</name>
                  <description>As least 1 interrupt is pending</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>None</name>
                  <description>No interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INTID</name>
              <description>Interrupt ID of RX FIFO</description>
              <bitRange>[3:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>3a</name>
                  <description>THRE interrupt</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2a</name>
                  <description>RDA (Receive Data Available)</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1</name>
                  <description>RLS (Receive Line Status)</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2b</name>
                  <description>Character Time-out Indicator (CTI)</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>3b</name>
                  <description>TEMT interrupt</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FIFOEN</name>
              <description>Equal to FIFOEN bit in UARTn_FIFOCTRL register</description>
              <bitRange>[7:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0b</name>
                  <description>FIFOEN bit = 0 in UARTn_FIFOCTRL register</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1b</name>
                  <description>FIFOEN bit = 1 in UARTn_FIFOCTRL register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_FIFOCTRL -->
        <register>
          <name>FIFOCTRL</name>
          <description>Offset:0x08 UARTn FIFO Control register</description>
          <alternateRegister>II</alternateRegister>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x000000C1</resetMask>
          
          <fields>
            <field>
              <name>FIFOEN</name>
              <description>FIFO enable</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable FIFO</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXTL</name>
              <description>RX trigger level</description>
              <bitRange>[7:6]</bitRange>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Trigger level 0</name>
                  <description>1 character</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_LC -->
        <register>
          <name>LC</name>
          <description>Offset:0x0C UARTn Line Control register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>WLS</name>
              <description>Word length selection</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>5-bit</name>
                  <description>5-bit character</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>6-bit</name>
                  <description>6-bit character</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>7-bit</name>
                  <description>7-bit character</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8-bit</name>
                  <description>8-bit character</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SBS</name>
              <description>Stop bit selection</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1</name>
                  <description>1 stop bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2/1.5</name>
                  <description>2 stop bits (1.5 stop bit if WLS=0)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PE</name>
              <description>Parity enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable parity generation and checking</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable parity generation and checking</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PS</name>
              <description>Parity selection</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Odd</name>
                  <description>Odd parity</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Even</name>
                  <description>Even parity</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Forced 1</name>
                  <description>Forced 1 sticky parity</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Forced 0</name>
                  <description>Forced 0 sticky parity</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BC</name>
              <description>Break control</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable break transmission</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable break transmission</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DLAB</name>
              <description>Divisor Latch access</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable access to Divisor Latch</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable access to Divisor Latch</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_LS -->
        <register>
          <name>LS</name>
          <description>Offset:0x14 UARTn Line Status register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000060</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>RDR</name>
              <description>Receiver data ready flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Not ready</name>
                  <description>UARTn_RB FIFO is empty</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ready</name>
                  <description>UARTn_RB FIFO contains valid data</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OE</name>
              <description>Overrun error flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No overrun error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Overrun error</name>
                  <description>Overrun error status is active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PE</name>
              <description>Parity error flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No parity error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Parity error</name>
                  <description>Parity error status is active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FE</name>
              <description>Framing error flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No framing error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Framing error</name>
                  <description>Framing error status is active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BI</name>
              <description>Break interrupt flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No break interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Break interrupt</name>
                  <description>Break interrupt status is active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>THRE</name>
              <description>THR empty flag</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Not empty</name>
                  <description>THR contains valid data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Empty</name>
                  <description>THR (TX FIFO) is empty</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TEMT</name>
              <description>Transmitter empty flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Not empty</name>
                  <description>THR and/or TSR contains valid data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Empty</name>
                  <description>THR and TSR are both empty</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXFE</name>
              <description>Receiver FIFO error flag</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No RX FIFO error</name>
                  <description>UARTn_RB contains no UART RX errors</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RX FIFO error</name>
                  <description>UARTn_RB contains at least 1 UART RX error</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_SP -->
        <register>
          <name>SP</name>
          <description>Offset:0x1C UARTn Scratch Pad register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>PAD</name>
              <description>Pad informaton</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_FD -->
        <register>
          <name>FD</name>
          <description>Offset:0x28 UARTn Fractional Divider register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001FF</resetMask>
          
          <fields>
            <field>
              <name>DIVADDVAL</name>
              <description>Baud rate generation prescaler divisor value</description>
              <bitRange>[3:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>MULVAL</name>
              <description>Baud rate generation prescaler multiplier value</description>
              <bitRange>[7:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0000</name>
                  <description>Baud rate prescaler multiplier value is 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0001</name>
                  <description>Baud rate prescaler multiplier value is 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0010</name>
                  <description>Baud rate prescaler multiplier value is 3</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0011</name>
                  <description>Baud rate prescaler multiplier value is 4</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0100</name>
                  <description>Baud rate prescaler multiplier value is 5</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0101</name>
                  <description>Baud rate prescaler multiplier value is 6</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0110</name>
                  <description>Baud rate prescaler multiplier value is 7</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0111</name>
                  <description>Baud rate prescaler multiplier value is 8</description>
                  <value>7</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1000</name>
                  <description>Baud rate prescaler multiplier value is 9</description>
                  <value>8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1001</name>
                  <description>Baud rate prescaler multiplier value is 10</description>
                  <value>9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1010</name>
                  <description>Baud rate prescaler multiplier value is 11</description>
                  <value>10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1011</name>
                  <description>Baud rate prescaler multiplier value is 12</description>
                  <value>11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1100</name>
                  <description>Baud rate prescaler multiplier value is 13</description>
                  <value>12</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1101</name>
                  <description>Baud rate prescaler multiplier value is 14</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1110</name>
                  <description>Baud rate prescaler multiplier value is 15</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1111</name>
                  <description>Baud rate prescaler multiplier value is 16</description>
                  <value>15</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OVER8</name>
              <description>Oversampling value</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>16</name>
                  <description>Oversampling by 16</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8</name>
                  <description>Oversampling by 8</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x30 UARTn Control register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x000000C0</resetValue>
          <resetMask>0x000000CF</resetMask>
          
          <fields>
            <field>
              <name>UARTEN</name>
              <description>UART enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable UART</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable UART</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MODE</name>
              <description>UART mode</description>
              <bitRange>[3:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UART</name>
                  <description>UART mode</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RXEN</name>
              <description>RX enable</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable RX</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable RX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXEN</name>
              <description>TX enable</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable TX</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable TX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_HDEN -->
        <register>
          <name>HDEN</name>
          <description>Offset:0x34 UARTn Control register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>HDEN</name>
              <description>Half-duplex mode enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable half-duplex mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable half-duplex mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UART0_DMA -->
        <register>
          <name>DMA</name>
          <description>Offset:0x50 UARTn DMA mode register</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x007FFFFF</resetMask>
          
          <fields>
            <field>
              <name>DMA_SIZE</name>
              <description>Total DMA transfer size (in byte)</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DMA_EN</name>
              <description>UART DMA mode enable</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable UART DMA mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable UART DMA mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>        
      </registers>
    </peripheral>
    
    <!-- SN_I2C0 -->
    <peripheral>
      <name>SN_I2C0</name>
      <version>1.0</version>
      <description>I2C0</description>
      <groupName>I2C</groupName>
      <baseAddress>0x40018000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>I2C0</name>
        <description>I2C0 interrupt</description>
        <value>10</value>
      </interrupt>
      
      <registers>
        <!-- SN_I2C0_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x00 I2Cn Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00300000</resetValue>
          <resetMask>0x003001B6</resetMask>
          
          <fields>
            <field>
              <name>NACK</name>
              <description>NACK assert flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Assert</name>
                  <description>Assert NACK during the acknowledge clock pulse on SCLn</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACK</name>
              <description>ACK assert flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>Master: No action/Slave: Assert NACK after receiving</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Assert</name>
                  <description>Assert ACK during the acknowledge clock pulse on SCLn</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STO</name>
              <description>STOP assert flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>STOP condition idle</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Assert</name>
                  <description>Transmit a STOP condition in master mode, or recover from an error condition in slave mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STA</name>
              <description>START assert flag</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No START condition or Repeated START condition will be generated</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Assert</name>
                  <description>Enter master mode and transmit a START or Repeated START condition</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CMODE</name>
              <description>I2C mode</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Standard/Fast</name>
                  <description>Standard/Fast mode</description>
                  <value>0</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CEN</name>
              <description>I2Cn interface enable</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable I2C</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable I2C</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SCLL_HF_SEL</name>
              <description>I2C TX_BIT changing timing bit</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SCL negative edge</name>
                  <description>Change at SCL negative edge</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Half of SCL low edge</name>
                  <description>Change at half of SCL low edge</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ARBITRATION</name>
              <description>Master Arbitration Enable bit</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable Arbitration</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable Arbitration</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_STAT -->
        <register>
          <name>STAT</name>
          <description>Offset:0x04 I2Cn Status register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000083FF</resetMask>
          
          <fields>
            <field>
              <name>RX_DN</name>
              <description>RX done status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Not done</name>
                  <description>No RX with ACK/NACK transfer</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Done</name>
                  <description>8-bit RX with ACK/NACK transfer</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ACK_STAT</name>
              <description>ACK done status</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No ACK received</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Done</name>
                  <description>Receive an ACK</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>NACK_STAT</name>
              <description>NACK done status</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No NACK received</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Done</name>
                  <description>Receive a NACK</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STOP_DN</name>
              <description>STOP done status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No STOP condition</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Done</name>
                  <description>Transmit or receive a STOP condition</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>START_DN</name>
              <description>START done status</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No START condition</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Assert</name>
                  <description>Transmit or receive a START condition</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MST</name>
              <description>I2C master/slave status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Slave</name>
                  <description>Act as Slave</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Master</name>
                  <description>Act as Master</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SLV_RX_HIT</name>
              <description>Slave RX address hit flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No matched slave address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Hit</name>
                  <description>Slave address hit, and is called for RX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SLV_TX_HIT</name>
              <description>Slave TX address hit flag</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No matched slave address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Hit</name>
                  <description>Slave address hit, and is called for TX</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOST_ARB</name>
              <description>Lost arbitration status</description>
              <bitRange>[8:8]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>Not lost arbitration</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Lost</name>
                  <description>Lost arbitration</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TIMEOUT</name>
              <description>Time-out status</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No timeout</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TO</name>
                  <description>Timeout</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>I2CIF</name>
              <description>I2C interrupt flag</description>
              <bitRange>[15:15]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>I2C status doesn't change</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Change</name>
                  <description>I2C status changes</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_TXDATA -->
        <register>
          <name>TXDATA</name>
          <description>Offset:0x08 I2Cn TX Data register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>Data</name>
              <description>TX Data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_RXDATA -->
        <register>
          <name>RXDATA</name>
          <description>Offset:0x0C I2Cn RX Data register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>Data</name>
              <description>RX Data received when RX_DN=1</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SLVADDR0 -->
        <register>
          <name>SLVADDR0</name>
          <description>Offset:0x10 I2Cn Slave Address 0 register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xC00003FF</resetMask>
          
          <fields>
            <field>
              <name>ADDR</name>
              <description>I2Cn slave address 0</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>GCEN</name>
              <description>General call address enable</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable general call address</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable general call address (0x0)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADD_MODE</name>
