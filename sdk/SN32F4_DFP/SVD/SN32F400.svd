    <!-- SN_FOC -->
    <peripheral>
      <name>SN_FOC</name>
      <version>1.0</version>
      <description>BLDC FOC Function</description>
      <groupName>FOC</groupName>
      <baseAddress>0x40074000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>FOC</name>
        <description>FOC interrupt</description>
        <value>22</value>
      </interrupt>
      
      <registers>
        <!-- SN_FOC_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x00 FOC Control register</description>
