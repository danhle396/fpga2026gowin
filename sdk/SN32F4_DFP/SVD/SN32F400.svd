                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR0STOP</name>
              <description>Stop TC and PC and clear CEN bit when MR0 matches TC</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
