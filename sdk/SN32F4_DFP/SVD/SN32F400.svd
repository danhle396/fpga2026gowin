      </registers>
    </peripheral>
    
    <!-- SN_ADC -->
    <peripheral>
      <name>SN_ADC</name>
      <version>1.0</version>
      <description>ADC</description>
      <groupName>ADC</groupName>
      <baseAddress>0x40026000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>ADC</name>
        <description>ADC interrupt</description>
        <value>24</value>
      </interrupt>
      
      <registers>
        <!-- SN_ADC_ADM -->
        <register>
          <name>ADM</name>
          <description>Offset:0x00 ADC Management register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000080</resetValue>
          <resetMask>0x0027FFF0</resetMask>
          
          <fields>
            <field>
              <name>GCHS</name>
              <description>ADC global channel enable</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable AIN channel</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable AIN channel</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EOC</name>
              <description>ADC status</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>ADC is processing</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>End</name>
                  <description>End of processing</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADS</name>
              <description>ADC start control</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop</name>
                  <description>ADC stops</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Start</name>
                  <description>Start ADC conversion</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADLEN</name>
              <description>ADC resolution</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>8-bit</name>
                  <description>8-bit ADB</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>12-bit</name>
                  <description>12-bit ADB</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCKS</name>
              <description>ADC clock source divider</description>
              <bitRange>[10:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>ADC_PCLK/1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>ADC_PCLK/2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>ADC_PCLK/4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>ADC_PCLK/8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>ADC_PCLK/16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>ADC_PCLK/32</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADENB</name>
              <description>ADC enable</description>
              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable ADC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable ADC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>AVREFHSEL</name>
              <description>ADC high reference voltage source</description>
              <bitRange>[12:12]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Interal VDD</name>
                  <description>P2.0 acts as GPIO or AIN0 pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>External reference voltage</name>
                  <description>P2.0 acts as AVREFH pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>VHS</name>
              <description>Internal Ref. voltage source</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>Internal 2.0V as ADC internal reference voltage</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>Internal 3.0V as ADC internal reference voltage</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>Internal 4.5V as ADC internal reference voltage</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>Internal 1.5V as ADC internal reference voltage</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>VDD as ADC internal reference voltage, Internal 2.0V as AIN18</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>VDD as ADC internal reference voltage, Internal 3.0V as AIN18</description>
                  <value>5</value>
                </enumeratedValue>
