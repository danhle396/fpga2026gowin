                <enumeratedValue>
                  <name>PLL_VCO</name>
                  <description>CT16Bn PCLK source=PLL_VCO</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKSEL1</name>
              <description>CT16B1 PCLK source</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HCLK</name>
                  <description>CT16Bn PCLK source=HCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL_VCO</name>
                  <description>CT16Bn PCLK source=PLL_VCO</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CLKSEL5</name>
              <description>CT16B5 PCLK source</description>
              <bitRange>[6:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HCLK</name>
                  <description>CT16Bn PCLK source=HCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL_VCO</name>
                  <description>CT16Bn PCLK source=PLL_VCO</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ELS Xtal</name>
                  <description>CT16Bn PCLK source=ELS Xtal</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ILRC</name>
                  <description>CT16Bn PCLK source=ILRC</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_FLASH -->
    <peripheral>
      <name>SN_FLASH</name>
      <version>1.0</version>
      <description>FLASH Memory Control Registers</description>
      <groupName>FLASH</groupName>
      <baseAddress>0x40062000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_FLASH_LPCTRL -->
        <register>
          <name>LPCTRL</name>
          <description>Offset:0x00 Flash Low Power Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF003F</resetMask>
          
          <fields>
            <field>
              <name>LPMODE</name>
              <description>Flash Low Power mode selection bit</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0x0</name>
                  <description>HCLK is less than 24MHz</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0x19</name>
                  <description>HCLK is more than or equal to 24MHz, and less than or equal to 48MHz</description>
                  <value>41</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0x29</name>
                  <description>HCLK is more than 48MHz</description>
                  <value>57</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FMCKEY</name>
              <description>FMC verify key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_STATUS -->
        <register>
          <name>STATUS</name>
          <description>Offset:0x04 Flash Status register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000005</resetMask>
          
          <fields>
            <field>
              <name>BUSY</name>
              <description>Busy flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>FMC is idle</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>Flash operation is in process</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERR</name>
              <description>Erase/Error flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Error</name>
                  <description>The address is illegal or over page boundary</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x08 Flash Control register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000C7</resetMask>
          
          <fields>
            <field>
              <name>PG</name>
              <description>Flash program mode chosen bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable Flash program mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable Flash program mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PER</name>
              <description>Page erase mode chosen bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable page erase mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable page erase mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            
            <field>
              <name>START</name>
              <description>Start erase/program operation</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop/Finish</name>
                  <description>Stop/finish operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Start</name>
                  <description>Start erase/program operation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHK</name>
              <description>Checksum calculation chosen</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable checksum calcuation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Trigger checksum calculation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_DATA -->
        <register>
          <name>DATA</name>
          <description>Offset:0x0C Flash Data register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DATA</name>
              <description>Flash data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_ADDR -->
        <register>
          <name>ADDR</name>
          <description>Offset:0x10 Flash Address register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ADDR</name>
              <description>Flash address</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_CHKSUM -->
        <register>
          <name>CHKSUM</name>
          <description>Offset:0x14 Flash Checksum register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>UserROM</name>
              <description>Checksum of User ROM</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>BootROM</name>
              <description>Checksum of Boot ROM</description>
              <bitRange>[31:16]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_WP -->
        <register>
          <name>WP</name>
          <description>Offset:0x20 Flash Write Protect register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>WP</name>
              <description>Flash Write protect key</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_DMA0 -->
    <peripheral>
      <name>SN_DMA0</name>
      <version>1.0</version>
      <description>Direct Memory Access</description>
      <groupName>DMA</groupName>
      <baseAddress>0x40072000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>DMA0</name>
        <description>Direct Memory Access</description>
        <value>1</value>
      </interrupt>
      
      <registers>
        <!-- SN_DMA0_INT -->
        <register>
          <name>INT</name>
          <description>Offset:0x00 DMA0 Interrupt Status register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000001F</resetMask>
          
          <fields>
            <field>
              <name>INT0</name>
              <description>The result of INT_ABT0 | INT_ERR0 | INT_TC0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>Channel 0 has no pending interrupt</description>
