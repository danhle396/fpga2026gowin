              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable capture function</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable CAP0 function for external Capture pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CT16B0_CAP0 -->
        <register>
          <name>CAP0</name>
          <description>Offset:0x2C CT16Bn CAP0 register</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>CAP0</name>
              <description>Timer counter capture value</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_CT16B0_EM -->
        <register>
          <name>EM</name>
          <description>Offset:0x30 CT16Bn External Match register</description>
          <addressOffset>0x30</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000FFF</resetMask>
          
          <fields>
            <field>
              <name>EM0</name>
              <description>When the TC doesn't match MR0 and EMC0 is not 0, this bit will drive the state of CT16Bn_PWM0 output</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Drive the state of CT16Bn_PWM0 output to Low when the TC doesn't match MR0 and EMC0 is not 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Drive the state of CT16Bn_PWM0 output to High when the TC doesn't match MR0 and EMC0 is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EM1</name>
              <description>When the TC doesn't match MR1 and EMC1 is not 0, this bit will drive the state of CT16Bn_PWM1 output</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Drive the state of CT16Bn_PWM1 output to Low when the TC doesn't match MR1 and EMC1 is not 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Drive the state of CT16Bn_PWM1 output to High when the TC doesn't match MR1 and EMC1 is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EM2</name>
              <description>When the TC doesn't match MR2 and EMC2 is not 0, this bit will drive the state of CT16Bn_PWM2 output</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Drive the state of CT16Bn_PWM2 output to Low when the TC doesn't match MR2 and EMC2 is not 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Drive the state of CT16Bn_PWM2 output to High when the TC doesn't match MR2 and EMC2 is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EM3</name>
              <description>When the TC doesn't match MR3 and EMC3 is not 0, this bit will drive the state of CT16Bn_PWM3 output</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Low</name>
                  <description>Drive the state of CT16Bn_PWM3 output to Low when the TC doesn't match MR3 and EMC3 is not 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>Drive the state of CT16Bn_PWM3 output to High when the TC doesn't match MR3 and EMC3 is not 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMC0</name>
              <description>CT16Bn_PWM0 functionality when MR0=TC</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Nothing</name>
                  <description>Do nothing</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>CT16Bn_PWM0 pin is LOW</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>CT16Bn_PWM0 pin is HIGH</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>Toggle CT16Bn_PWM0 pin</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMC1</name>
              <description>CT16Bn_PWM1 functionality when MR1=TC</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Nothing</name>
                  <description>Do nothing</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>CT16Bn_PWM1 pin is LOW</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>CT16Bn_PWM1 pin is HIGH</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>Toggle CT16Bn_PWM1 pin</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMC2</name>
              <description>CT16Bn_PWM2 functionality when MR2=TC</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Nothing</name>
                  <description>Do nothing</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>CT16Bn_PWM2 pin is LOW</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>CT16Bn_PWM2 pin is HIGH</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>Toggle CT16Bn_PWM2 pin</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EMC3</name>
              <description>CT16Bn_PWM3 functionality when MR3=TC</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Nothing</name>
                  <description>Do nothing</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>CT16Bn_PWM3 pin is LOW</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>High</name>
                  <description>CT16Bn_PWM3 pin is HIGH</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Toggle</name>
                  <description>Toggle CT16Bn_PWM3 pin</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CT16B0_PWMCTRL -->
        <register>
          <name>PWMCTRL</name>
          <description>Offset:0x34 CT16Bn PWM Control register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFF00FFF</resetMask>
          
          <fields>
            <field>
              <name>PWM0EN</name>
              <description>PWM0 enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM0 is controlled by EMC0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1EN</name>
              <description>PWM1 enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM1 is controlled by EMC1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2EN</name>
              <description>PWM2 enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM2 is controlled by EMC2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3EN</name>
              <description>PWM2 enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM3 is controlled by EMC3</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM3</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0MODE</name>
              <description>PWM0 output mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM0 is 0 when TC is less than MR0.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM0 is 1 when TC is less than MR0.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM0 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM0 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1MODE</name>
              <description>PWM1 output mode</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM1 is 0 when TC is less than MR1.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM1 is 1 when TC is less than MR1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM1 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM1 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2MODE</name>
              <description>PWM2 output mode</description>
              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM2 is 0 when TC is less than MR2.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM2 is 1 when TC is less than MR2.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM2 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM2 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3MODE</name>
              <description>PWM3 output mode</description>
              <bitRange>[11:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM3 is 0 when TC is less than MR3.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM3 is 1 when TC is less than MR3.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM3 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM3 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0IOEN</name>
              <description>CT16Bn_PWM0/GPIO selection</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM0 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>CT16Bn_PWM0 pin act as match output, and output depends on PWM0EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1IOEN</name>
              <description>CT16Bn_PWM1/GPIO selection</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM1 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>CT16Bn_PWM1 pin act as match output, and output depends on PWM1EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2IOEN</name>
              <description>CT16Bn_PWM2/GPIO selection</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM2 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>CT16Bn_PWM2 pin act as match output, and output depends on PWM2EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3IOEN</name>
              <description>CT16Bn_PWM3/GPIO selection</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM3 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>CT16Bn_PWM3 pin act as match output, and output depends on PWM3EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0NIOEN</name>
              <description>CT16Bn_PWM0N/GPIO selection bit</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GPIO</name>
                  <description>CT16Bn_PWM0N pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse1</name>
                  <description>CT16Bn_PWM0N pin outputs the inverse signal with dead-band of CT16Bn_PWM0, but same High signal during dead-band period</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse2</name>
                  <description>CT16Bn_PWM0N pin outputs the inverse signal with dead-band of CT16Bn_PWM0, but same Low signal during dead-band period</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Same</name>
                  <description>CT16Bn_PWM0N pin outputs the same signal with dead-band of CT16Bn_PWM0</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1NIOEN</name>
              <description>CT16Bn_PWM0N/GPIO selection bit</description>
              <bitRange>[27:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GPIO</name>
                  <description>CT16Bn_PWM1N pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse1</name>
                  <description>CT16Bn_PWM1N pin outputs the inverse signal with dead-band of CT16Bn_PWM0, but same High signal during dead-band period</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse2</name>
                  <description>CT16Bn_PWM1N pin outputs the inverse signal with dead-band of CT16Bn_PWM0, but same Low signal during dead-band period</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Same</name>
                  <description>CT16Bn_PWM1N pin outputs the same signal with dead-band of CT16Bn_PWM0</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2NIOEN</name>
              <description>CT16Bn_PWM0N/GPIO selection bit</description>
              <bitRange>[29:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>GPIO</name>
                  <description>CT16Bn_PWM2N pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse1</name>
                  <description>CT16Bn_PWM2N pin outputs the inverse signal with dead-band of CT16Bn_PWM0, but same High signal during dead-band period</description>
                  <value>1</value>
