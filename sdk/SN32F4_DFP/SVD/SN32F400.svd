        <!-- SN_CT16B1_MR9 -->
        <register>
          <name>MR9</name>
          <description>Offset:0x40 CT16Bn MR9 register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>MR</name>
              <description>Timer counter match value</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_CT16B1_LOADCTRL -->
        <register>
          <name>LOADCTRL</name>
          <description>Offset:0x74 CT16Bn PWM Load Mode Control register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000055</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>LOAD_MR0</name>
              <description>MR0 load mode selection in center-aligned mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Load MR0 value at TC=0 and MR0 value is unchanged at TC=MR9</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>MR0 value is unchanged at TC=0 and Load MR0 value at TC=MR9</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Load MR0 value at TC=0 and TC=MR9</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOAD_MR1</name>
              <description>MR1 load mode selection in center-aligned mode</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Load MR1 value at TC=0 and MR1 value is unchanged at TC=MR9</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>MR1 value is unchanged at TC=0 and Load MR1 value at TC=MR9</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Load MR1 value at TC=0 and TC=MR9</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOAD_MR2</name>
