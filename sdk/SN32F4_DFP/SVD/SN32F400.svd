          <description>Offset:0x114 FOC Maximum Output Limit for Q-axis Current PI Controller register</description>
          <addressOffset>0x114</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_MAX</name>
              <description>Maximum output limit for q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_MIN -->
        <register>
          <name>IQ_PI_MIN</name>
          <description>Offset:0x118 FOC Minimum Output Limit for Q-axis Current PI Controller register</description>
          <addressOffset>0x118</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_MIN</name>
              <description>Minimum output limit for q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_CMD -->
        <register>
          <name>IQ_PI_CMD</name>
          <description>Offset:0x11C FOC Command for Q-axis Current PI Controller register</description>
          <addressOffset>0x11C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_CMD</name>
              <description>Command for q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_FB -->
        <register>
          <name>IQ_PI_FB</name>
          <description>Offset:0x120 FOC Feedback for Q-axis Current PI Controller register</description>
          <addressOffset>0x120</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_FB</name>
              <description>Feedback for q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_FF -->
        <register>
          <name>IQ_PI_FF</name>
          <description>Offset:0x124 FOC Feedforward for Q-axis Current PI Controller register</description>
          <addressOffset>0x124</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_FF</name>
              <description>Feedforward for q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_OUT -->
        <register>
          <name>IQ_PI_OUT</name>
          <description>Offset:0x128 FOC Output of Q-axis Current PI Controller register</description>
          <addressOffset>0x128</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_OUT</name>
              <description>Output of q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_ERR -->
        <register>
          <name>IQ_PI_ERR</name>
          <description>Offset:0x12C FOC Error of Q-axis Current PI Controller register</description>
          <addressOffset>0x12C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_ERR</name>
              <description>Error of q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_UP -->
        <register>
          <name>IQ_PI_UP</name>
          <description>Offset:0x130 FOC Proportional Output of Q-axis Current PI Controller register</description>
          <addressOffset>0x130</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_UP</name>
              <description>Proportional output of q-axis current PI controller in I24Q15 format</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FOC_IQ_PI_UI -->
        <register>
          <name>IQ_PI_UI</name>
          <description>Offset:0x134 FOC Integral Outputof Q-axis Current PI Controller register</description>
          <addressOffset>0x134</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>IQ_PI_UI</name>
              <description>Integral output of q-axis current PI controller in I32Q30 format</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_ACC -->
    <peripheral>
      <name>SN_ACC</name>
      <version>1.0</version>
      <description>Atan, Div and Sqrt Function</description>
      <groupName>ACC</groupName>
      <baseAddress>0x40076000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>SQRT</name>
        <description>SQRT interrupt</description>
        <value>17</value>
      </interrupt>
      
      <interrupt>
        <name>ATAN</name>
        <description>ATAN interrupt</description>
        <value>19</value>
      </interrupt>
      
      <interrupt>
        <name>DIV</name>
        <description>DIV interrupt</description>
        <value>20</value>
      </interrupt>
      
      <registers>
        <!-- SN_ACC_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x00 ACC Hardware Calculation Accelerator Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000007FF</resetMask>
          
          <fields>
            <field>
              <name>ACC_EN</name>
              <description>Hardware calculation accelerator enable bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable the hardware accelerator</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable the hardware accelerator</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IE</name>
              <description>Hardware calculation accelerator interrupt enable bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable ACC interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable ACC interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ATAN_START_PULSE</name>
              <description>Arctangent operation trigger bit</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>Trigger 1 pulse to start ATAN operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ATAN_RDY</name>
              <description>Arctangent ready status</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>ATAN is operating</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>ATAN is not operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ATAN_INT</name>
              <description>Arctangent interrupt signal</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No ATAN interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Meet</name>
                  <description>ATAN interrupt is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_START_PULSE</name>
              <description>Division operation trigger bit</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>Trigger 1 pulse to start DIV operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_RDY</name>
              <description>Division ready status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>DIV is operating</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>DIV is not operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_INT</name>
              <description>Division interrupt signal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No DIV interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Meet</name>
                  <description>DIV interrupt is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_START_PULSE</name>
              <description>Square root operation trigger bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>Trigger 1 pulse to start SRQT operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_RDY</name>
              <description>Square root ready status</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>SQRT is operating</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>SQRT is not operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_INT</name>
              <description>Square root interrupt signal</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No SQRT interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Meet</name>
                  <description>SQRT interrupt is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_ATAN_IN -->
        <register>
          <name>ATAN_IN</name>
          <description>Offset:0x04 ACC Arctangent Input register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ATAN_X</name>
              <description>Arctangent x-axis input value in I16Q15 format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ATAN_Y</name>
              <description>Arctangent y-axis input value in I16Q15 format</description>
              <bitRange>[31:16]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_ATAN_OUT -->
        <register>
          <name>ATAN_OUT</name>
          <description>Offset:0x08 ACC Arctangent Output register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0003FFFF</resetMask>
          
          <fields>
            <field>
              <name>ATAN_OUT</name>
              <description>Arctangent output value in I18Q15 format. Result is between -pi and pi</description>
              <bitRange>[17:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_DVD -->
        <register>
          <name>DIV_DVD</name>
          <description>Offset:0x0C ACC Dividend Input for Division register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_DVD</name>
              <description>Dividend input for division in signed 32-bit format</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_DVS -->
        <register>
          <name>DIV_DVS</name>
          <description>Offset:0x10 ACC Divisor Input for Division register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_DVS</name>
              <description>Divisor input for division in signed 16-bit format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_QUO -->
        <register>
          <name>DIV_QUO</name>
          <description>Offset:0x14 ACC Quotient Output of Division register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_QUO</name>
              <description>Quotient output of division in signed 32-bit format</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_REM -->
        <register>
          <name>DIV_REM</name>
          <description>Offset:0x18 ACC Reminder Output of Division register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_REM</name>
              <description>Reminder output of division in signed 16-bit format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_SQRT_IN -->
        <register>
          <name>SQRT_IN</name>
          <description>Offset:0x1C ACC Square Root Input register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>SQRT_IN</name>
              <description>Square root input value in unsigned 32-bit format</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_SQRT_OUT -->
        <register>
          <name>SQRT_OUT</name>
          <description>Offset:0x20 ACC Square Root Output register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>SQRT_OUT</name>
              <description>Square root output value in unsigned 16-bit format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_UART1 -->
    <peripheral derivedFrom="SN_UART0">
      <name>SN_UART1</name>
      <baseAddress>0x40056000</baseAddress>
      
      <interrupt>
        <name>UART1</name>
        <description>UART1 interrupt</description>
        <value>14</value>
      </interrupt>
    </peripheral>
    
  </peripherals>
</device>