                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 0 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INT1</name>
