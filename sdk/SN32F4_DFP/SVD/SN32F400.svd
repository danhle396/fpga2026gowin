              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>7-bit</name>
                  <description>7-bit slave address mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10-bit</name>
                  <description>10-bit slave address mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SLVADDR1 -->
        <register>
          <name>SLVADDR1</name>
          <description>Offset:0x14 I2Cn Slave Address 1 register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x3FFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ADDR1</name>
              <description>I2Cn slave address 1</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR2</name>
              <description>I2Cn slave address 2</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR3</name>
              <description>I2Cn slave address 3</description>
              <bitRange>[29:20]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SLVADDR2 -->
        <register>
          <name>SLVADDR2</name>
          <description>Offset:0x18 I2Cn Slave Address 2 register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x3FFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ADDR4</name>
              <description>I2Cn slave address 4</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR5</name>
              <description>I2Cn slave address 5</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR6</name>
              <description>I2Cn slave address 6</description>
              <bitRange>[29:20]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SLVADDR3 -->
        <register>
          <name>SLVADDR3</name>
          <description>Offset:0x1C I2Cn Slave Address 3 register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x3FFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ADDR7</name>
              <description>I2Cn slave address 7</description>
              <bitRange>[9:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR8</name>
              <description>I2Cn slave address 8</description>
              <bitRange>[19:10]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ADDR9</name>
              <description>I2Cn slave address 9</description>
              <bitRange>[29:20]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SCLHT -->
        <register>
          <name>SCLHT</name>
          <description>Offset:0x20 I2Cn SCL High Time register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>SCLH</name>
              <description>SCLn High period time=(SCLHT+1)*I2Cn_PCLK cycle</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SCLLT -->
        <register>
          <name>SCLLT</name>
          <description>Offset:0x24 I2Cn SCL Low Time register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000004</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>SCLL</name>
              <description>SCLn Low period time=(SCLLT+1)*I2Cn_PCLK cycle</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_SETUPT -->
        <register>
          <name>SETUPT</name>
          <description>Offset:0x28 I2Cn Setup Time register</description>
          <addressOffset>0x28</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x0000000F</resetValue>
          <resetMask>0x80FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>START_SETUP</name>
              <description>START setup time = (START_SETUP +1) * I2Cn_PCLK cycle</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>STOP_SETUP</name>
              <description>STOP setup time = (STOP_SETUP +1) * I2Cn_PCLK cycle</description>
              <bitRange>[15:8]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>DATA_SETUP</name>
              <description>DATA setup time = (DATA_SETUP +1) * I2Cn_PCLK cycle</description>
              <bitRange>[23:16]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SETUP_TIME_SEL</name>
              <description>Setup unit time selection</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PCLK</name>
                  <description>SETUP unit time = PCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>User defined</name>
                  <description>SETUP unit time = User defined (ns)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_TOCTRL -->
        <register>
          <name>TOCTRL</name>
          <description>Offset:0x2C I2Cn Timeout Control register</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>TO</name>
              <description>Timeout period time = TO*32*I2Cn_PCLK cycle</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_I2C0_DMA -->
        <register>
          <name>DMA</name>
          <description>Offset:0x50 I2Cn DMA mode register</description>
          <addressOffset>0x50</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xD03FFFFF</resetMask>
          
          <fields>
            <field>
              <name>DMA_SIZE</name>
              <description>Total DMA transfer size (in byte)</description>
              <bitRange>[21:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>RX_DMA_LAST_NACK</name>
              <description>I2C issues NACK/ACK for last data in RX DMA mode</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ACK</name>
                  <description>I2C issue ACK for last data in RX DMA mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>NACK</name>
                  <description>I2C issue NACK for last data in RX DMA mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RX_DMA_EN</name>
              <description>RX DMA mode enable</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable RX DMA mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable RX DMA mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TX_DMA_EN</name>
              <description>TX DMA mode enable</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable TX DMA mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable TX DMA mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    
    <!-- SN_SPI0 -->
    <peripheral>
      <name>SN_SPI0</name>
