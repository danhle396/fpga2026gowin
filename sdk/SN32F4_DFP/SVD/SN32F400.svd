        <!-- SN_CT16B0_BRKCTRL -->
        <register>
          <name>BRKCTRL</name>
          <description>Offset:0xE0 CT16Bn Break Function Control register</description>
          <addressOffset>0xE0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x4000007F</resetMask>
          
          <fields>
            <field>
              <name>BRKSEL</name>
              <description>The trigger source selection of PWM channels break function</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>Disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>CMP0 output</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>CMP1 output</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>CMP2 output</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>Break pin (BRK)</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>Noise detect output</description>
                  <value>5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKLEVEL</name>
              <description>The trigger level of PWM channels break function</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0b</name>
                  <description>Low level.  (CMP V- > V+)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1b</name>
                  <description>High level. (CMP V+ > V-)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKDB</name>
              <description>Break pin (BRK) debounce time</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1T</name>
                  <description>Debounce time=1*CT16B0_PCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2T</name>
                  <description>Debounce time=2*CT16B0_PCLK</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4T</name>
                  <description>Debounce time=4*CT16B0_PCLK</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8T</name>
                  <description>Debounce time=8*CT16B0_PCLK</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16T</name>
                  <description>Debounce time=16*CT16B0_PCLK</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32T</name>
                  <description>Debounce time=32*CT16B0_PCLK</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64T</name>
                  <description>Debounce time=64*CT16B0_PCLK</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128T</name>
                  <description>Debounce time=128*CT16B0_PCLK</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKIE</name>
              <description>Enable generating an interrupt when BRKIF = 1</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable generating an interrup</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Generating an interrupt when BRKIF = 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_CT16B1 -->
    <peripheral>
      <name>SN_CT16B1</name>
      <version>1.0</version>
      <description>16-bit Timer 1 with Capture function</description>
      <groupName>TIMER</groupName>
      <baseAddress>0x40002000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>CT16B1</name>
        <description>16-bit Timer 1</description>
        <value>16</value>
      </interrupt>
      
      <registers>
        <!-- SN_CT16B1_TMRCTRL -->
        <register>
          <name>TMRCTRL</name>
          <description>Offset:0x00 CT16Bn Timer Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000073</resetMask>
          
          <fields>
            <field>
              <name>CEN</name>
              <description>Counter enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable counter</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable Timer Counter and Prescale Counter for counting</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRST</name>
              <description>Counter Reset</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable counter reset</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reset Counter</name>
                  <description>Timer Counter and the Prescale Counter are synchronously reset on the next positive edge of PCLK</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM</name>
              <description>Counting mode selection</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Up-counting mode</name>
                  <description>Edge-aligned Up-counting mode </description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Down-counting mode</name>
                  <description>Edge-aligned Down-counting mode</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Center-aligned counting mode 1</name>
                  <description>The match interrupt flag is set during the down-counting period</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Center-aligned counting mode 2</name>
                  <description>The match interrupt flag is set during the up-counting period</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Center-aligned counting mode 3</name>
                  <description>The match interrupt flag is set during both up-counting and down-counting period</description>
                  <value>6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CT16B1_TC -->
        <register>
          <name>TC</name>
