                  <name>Disable</name>
                  <description>CT16Bn_PWM2 is controlled by EMC2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3EN</name>
              <description>PWM2 enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>CT16Bn_PWM3 is controlled by EMC3</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for CT16Bn_PWM3</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0MODE</name>
              <description>PWM0 output mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM0 is 0 when TC is less than MR0.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM0 is 1 when TC is less than MR0.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM0 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM0 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1MODE</name>
              <description>PWM1 output mode</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM1 is 0 when TC is less than MR1.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM1 is 1 when TC is less than MR1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM1 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM1 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2MODE</name>
