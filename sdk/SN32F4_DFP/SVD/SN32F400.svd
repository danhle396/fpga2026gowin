              <bitRange>[11:11]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable CM0O</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable CM0O</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM0G</name>
              <description>CMP0 interrupt trigger direction control bit</description>
              <bitRange>[13:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Falling range trigger</name>
                  <description>CMP0 output status is from high to low as V+ is less than V-</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Rising edge trigger</name>
                  <description>CMP0 output status is from low to high as V+ is more than V-</description>
