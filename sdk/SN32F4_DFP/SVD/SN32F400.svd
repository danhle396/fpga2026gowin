        <!-- SN_CT16B5_RIS -->
        <register>
          <name>RIS</name>
          <description>Offset:0x38 CT16Bn Raw Interrupt Status register</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000003F</resetMask>
          
          <fields>
            <field>
              <name>MR0IF</name>
              <description>Match channel 0 interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No interrupt</name>
                  <description>No interrupt on match channel 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR1IF</name>
              <description>Match channel 1 interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR2IF</name>
              <description>Match channel 2 interrupt flag</description>
              <bitRange>[2:2]</bitRange>
