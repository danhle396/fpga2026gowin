    <!-- SN_CMP -->
    <peripheral>
      <name>SN_CMP</name>
      <version>1.0</version>
      <description>Comparator</description>
      <groupName>CMP</groupName>
      <baseAddress>0x40028000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>CMP3</name>
        <description>CMP3 interrupt</description>
        <value>2</value>
      </interrupt>
      
      <interrupt>
        <name>CMP2</name>
        <description>CMP2 interrupt</description>
        <value>12</value>
      </interrupt>
      
      <interrupt>
        <name>CMP1</name>
        <description>CMP1 interrupt</description>
        <value>18</value>
      </interrupt>
      
      <interrupt>
        <name>CMP0</name>
