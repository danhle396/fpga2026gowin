              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <value>0</value>
                  <description>Disable IHRC frequency adjustment</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <value>1</value>
                  <description>Enable IHRC frequency adjustment</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIR</name>
              <description>IHRC frequency adjusting direction bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Positive</name>
                  <value>0</value>
                  <description>Positive direction</description>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Negative</name>
                  <value>1</value>
                  <description>Negative direction</description>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADJ</name>
              <description>IHRC frequency adjusting bits</description>
              <bitRange>[8:4]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>SYSKEY</name>
              <description>System register key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
  
        <!-- SN_SYS0_CT_CLKSEL -->
        <register>
          <name>CT_CLKSEL</name>
          <description>Offset:0x44 CT16Bn PCLK Clock Source Select register</description>
          <addressOffset>0x44</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000063</resetMask>
          
          <fields>
            <field>
              <name>CLKSEL0</name>
              <description>CT16B0 PCLK source</description>
