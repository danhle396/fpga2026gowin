                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 3</name>
                  <description>TC is incremented on both edges on the CAP0 input</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
