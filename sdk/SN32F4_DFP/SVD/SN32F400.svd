                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 4 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_DMA0_INT_TC_CLR -->
        <register>
          <name>INT_TC_CLR</name>
          <description>Offset:0x08 DMA0 Transfer Complete Interrupt Status Clear register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000001F</resetMask>
          
          <fields>
            <field>
              <name>INT_TC_CLR0</name>
