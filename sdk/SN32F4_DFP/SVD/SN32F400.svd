                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Low</name>
                  <description>CT16Bn_PWM3 pin is LOW</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
