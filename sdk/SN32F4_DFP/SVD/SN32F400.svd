                  <description>CM0P0/CM0P1/CM0P2 pins are GPIO mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P0</name>
                  <description>CM0P0 is positive input pin</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P1</name>
                  <description>CM0P1 is positive input pin</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P2</name>
                  <description>CM0P2 is positive input pin</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OP0O</name>
                  <description>OP0O is positive input pin</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OP1O</name>
                  <description>OP1O is positive input pin</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OP2O</name>
                  <description>OP2O is positive input pin</description>
                  <value>6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM0NS</name>
              <description>CMP0 Negative input pin</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CM0N0</name>
                  <description>CM0N0 is negative input pin</description>
                  <value>0</value>
