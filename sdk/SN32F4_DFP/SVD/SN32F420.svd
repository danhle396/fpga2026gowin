          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000077</resetMask>
          
          <fields>
            <field>
              <name>SYSCLKSEL</name>
              <description>System clock source selection</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IHRC</name>
                  <description>HCLK=IHRC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ILRC</name>
                  <description>HCLK=ILRC</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL Output</name>
                  <description>HCLK=PLL output</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSCLKST</name>
              <description>System clock switch status</description>
              <bitRange>[6:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IHRC</name>
                  <description>IHRC is used as system clock</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ILRC</name>
                  <description>ILRC is used as system clock</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PLL</name>
                  <description>PLL output is used as system clock</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SYS0_AHBCP -->
        <register>
          <name>AHBCP</name>
          <description>Offset:0x10 AHB Clock Prescale register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>
          
          <fields>
            <field>
              <name>AHBPRE</name>
              <description>AHB clock source prescaler</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>FAHB=FSYSCLK/1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>FAHB=FSYSCLK/2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>FAHB=FSYSCLK/4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>FAHB=FSYSCLK/8</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>FAHB=FSYSCLK/16</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>FAHB=FSYSCLK/32</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>110b</name>
                  <description>FAHB=FSYSCLK/64</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>111b</name>
                  <description>FAHB=FSYSCLK/128</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV1P5</name>
              <description>SYSCLK prescaler</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV1</name>
                  <description>SYSCLK = SYSCLK/1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV1P5</name>
                  <description>SYSCLK = SYSCLK/1.5</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SYS0_RSTST -->
        <register>
          <name>RSTST</name>
          <description>Offset:0x14 System Reset Status register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <resetMask>0x0000001F</resetMask>
          
          <fields>
            <field>
              <name>SWRSTF</name>
              <description>Software reset flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No SW reset occurred</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SW reset</name>
                  <description>SW reset occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WDTRSTF</name>
              <description>WDT reset flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No WDT reset occurred</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>WDR reset</name>
                  <description>WDT reset occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LVDRSTF</name>
              <description>LVD reset flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No LVD reset occurred</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>LVD reset</name>
                  <description>LVD reset occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXTRSTF</name>
              <description>External reset flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No Extenral reset occurred</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>External reset</name>
                  <description>External reset occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PORRSTF</name>
              <description>POR reset flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No POR occurred</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POR</name>
                  <description>POR occurred</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SYS0_EXRSTCTRL -->
        <register>
          <name>EXRSTCTRL</name>
          <description>Offset:0x1C External Reset Pin Control register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000001</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>RESETDIS</name>
              <description>External reset pin disable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>P3.6 acts as nRESET pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>P3.6 acts as GPIO pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SYS0_SWDCTRL -->
        <register>
          <name>SWDCTRL</name>
          <description>Offset:0x20 SWD Pin Control register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>SWDDIS</name>
              <description>SWD pin disable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable SWD pins</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable SWD pins</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SYS0_IVTM -->
        <register>
          <name>IVTM</name>
          <description>Offset:0x24 Interrupt Vector Table Mapping register</description>
          <addressOffset>0x24</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF0007</resetMask>
          
          <fields>
            <field>
              <name>IVTM</name>
              <description>Interrupt table mapping selection</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>Map to User ROM</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>Map to User ROM</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>Map to SRAM</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IVTMKEY</name>
              <description>IVTM register key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_FLASH -->
    <peripheral>
      <name>SN_FLASH</name>
      <version>1.0</version>
      <description>FLASH Memory Control Registers</description>
      <groupName>FLASH</groupName>
      <baseAddress>0x40062000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_FLASH_LPCTRL -->
        <register>
          <name>LPCTRL</name>
          <description>Offset:0x00 Flash Low Power Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFF003F</resetMask>
          
          <fields>
            <field>
              <name>LPMODE</name>
              <description>Flash Low Power mode selection bit</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0x0</name>
                  <description>HCLK is less than 24MHz</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>0x11</name>
                  <description>HCLK is more than or equal to 24MHz, and less than or equal to 48MHz</description>
                  <value>17</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FMCKEY</name>
              <description>FMC verify key</description>
              <bitRange>[31:16]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_STATUS -->
        <register>
          <name>STATUS</name>
          <description>Offset:0x04 Flash Status register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000005</resetMask>
          
          <fields>
            <field>
              <name>BUSY</name>
              <description>Busy flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>FMC is idle</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>Flash operation is in process</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ERR</name>
              <description>Erase/Error flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No error</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Error</name>
                  <description>The address is illegal or over page boundary</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x08 Flash Control register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000001C3</resetMask>
          
          <fields>
            <field>
              <name>PG</name>
              <description>Flash program mode chosen bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable Flash program mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable Flash program mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PER</name>
              <description>Page erase mode chosen bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable page erase mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable page erase mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>START</name>
              <description>Start erase/program operation</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop/Finish</name>
                  <description>Stop/finish operation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Start</name>
                  <description>Start erase/program operation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHK</name>
              <description>Checksum calculation chosen</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable checksum calcuation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Trigger checksum calculation</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHKRANGE</name>
              <description>Checksum range select bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>All User ROM</name>
                  <description>All User ROM (0x00000000~0x00007FFF)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Except the last 64 bytes</name>
                  <description>Calculate User ROM, except the last 64 bytes. (0x00000000~0x00007FBF)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_DATA -->
        <register>
          <name>DATA</name>
          <description>Offset:0x0C Flash Data register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DATA</name>
              <description>Flash data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_ADDR -->
        <register>
          <name>ADDR</name>
          <description>Offset:0x10 Flash Address register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>ADDR</name>
              <description>Flash address</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_CHKSUM -->
        <register>
          <name>CHKSUM</name>
          <description>Offset:0x14 Flash Checksum register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>UserROM</name>
              <description>Checksum of User ROM</description>
              <bitRange>[15:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_FLASH_WP -->
        <register>
          <name>WP</name>
          <description>Offset:0x20 Flash Write Protect register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>WP</name>
              <description>Flash Write protect key</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_DAC -->
    <peripheral>
      <name>SN_DAC</name>
      <version>1.0</version>
      <description>DAC</description>
      <groupName>DAC</groupName>
      <baseAddress>0x40064000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_DAC_ADM -->
        <register>
          <name>ADM</name>
          <description>Offset:0x00 DAC Management register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000101</resetMask>
          
          <fields>
            <field>
              <name>DACEN</name>
              <description>DAC0 enable bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable DAC</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable DAC</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DACBUFEN</name>
              <description>DAC0 Output buffer enable bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable DAO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable DAO</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_DAC_VIREF -->
        <register>
          <name>VIREF</name>
          <description>Offset:0x04 DAC Internal Reference Voltage Source register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000001</resetMask>
          
          <fields>
            <field>
              <name>VIREF</name>
              <description>DAC internal reference voltage (VIREF) source</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1.2V</name>
                  <description>DAC internal reference voltage (VIREF) source is 1.2V</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4.8V</name>
                  <description>DAC internal reference voltage (VIREF) source is 4.8V</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_DAC_DATACTRL -->
        <register>
          <name>DATACTRL</name>
          <description>Offset:0x10 DAC Data Control register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000000FF</resetMask>
          
          <fields>
            <field>
              <name>DATA</name>
              <description>8-bit DAC setup data bits.</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
