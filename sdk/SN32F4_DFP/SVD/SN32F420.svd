        <!-- SN_CMP_OS -->
        <register>
          <name>OS</name>
          <description>Offset:0xC CMP Output Status register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          
          <fields>
            <field>
              <name>CM0OUT</name>
              <description>CMP0 Output flag bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CMP0 V+ is less than V-</name>
                  <description>V0+ is less than V0-</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMP0 V+ is more than V-</name>
                  <description>V0+ is more than V0-</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1OUT</name>
              <description>CMP1 Output flag bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CMP1 V+ is less than V-</name>
                  <description>V1+ is less than V1-</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMP1 V+ is more than V-</name>
                  <description>V1+ is more than V1- voltage</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CMP_IE -->
        <register>
          <name>IE</name>
          <description>Offset:0x10 CMP Interrupt Enable register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          
          <fields>
            <field>
              <name>CM0IE</name>
              <description>CMP0 interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable CMP0 interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable CMP0 interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1IE</name>
              <description>CMP1 interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable CMP1 interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable CMP1 interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CMP_RIS -->
        <register>
          <name>RIS</name>
          <description>Offset:0x14 CMP Raw Interrupt Status register</description>
          <addressOffset>0x14</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          
          <fields>
            <field>
              <name>CM0IF</name>
              <description>CMP0 raw interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No interrupt on CMP0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on CMP0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1IF</name>
              <description>CMP1 raw interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No interrupt on CMP1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on CMP1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CMP_IC -->
        <register>
          <name>IC</name>
          <description>Offset:0x18 CMP Interrupt Clear register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>write-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000003</resetMask>
          
          <fields>
            <field>
              <name>CM0IC</name>
              <description>CMP0 interrupt flag clear bit</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>Clear CMP0 interrupt flag</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1IC</name>
              <description>CMP1 interrupt flag clear bit</description>
              <bitRange>[1:1]</bitRange>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>Clear CMP1 interrupt flag</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CMP_DB -->
        <register>
          <name>DB</name>
          <description>Offset:0x1C CMP Interrupt Clear register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000077</resetMask>
          
          <fields>
            <field>
              <name>CM0DB</name>
              <description>Count for CMP0 output debounce time</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>No CMP0 output debounce time</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>CMP0 output debounce time=2*CMP0_PCLK</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>CMP0 output debounce time=4*CMP0_PCLK</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>CMP0 output debounce time=8*CMP0_PCLK</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>CMP0 output debounce time=16*CMP0_PCLK</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>CMP0 output debounce time=32*CMP0_PCLK</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>110b</name>
                  <description>CMP0 output debounce time=64*CMP0_PCLK</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>111b</name>
                  <description>CMP0 output debounce time=128*CMP0_PCLK</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1DB</name>
              <description>Count for CMP1 output debounce time</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>No CMP1 output debounce time</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>CMP1 output debounce time=2*CMP1_PCLK</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>CMP1 output debounce time=4*CMP1_PCLK</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>CMP1 output debounce time=8*CMP1_PCLK</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>CMP1 output debounce time=16*CMP1_PCLK</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>CMP1 output debounce time=32*CMP1_PCLK</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>110b</name>
                  <description>CMP1 output debounce time=64*CMP1_PCLK</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>111b</name>
                  <description>CMP1 output debounce time=128*CMP1_PCLK</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_OPA -->
    <peripheral>
      <name>SN_OPA</name>
      <version>1.0</version>
      <description>OP Amplifier</description>
      <groupName>OPA</groupName>
      <baseAddress>0x4002A000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_OPA_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x0 OPA Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0003071F</resetMask>
          
          <fields>
            <field>
              <name>OP0EN0</name>
              <description>OPA0_0 enable bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable OPA0_0. OP0P0/P2.4 and OP0N0/P2.3 are GPIO mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable OPA0_0. OP0P0/P2.4 and OP0N0/P2.3 are OPA0 input pins.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP0EN1</name>
              <description>OPA0_1 enable bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable OPA0_1. OP0P1/P1.1 and OP0N1/P1.0 are GPIO mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable OPA0_1. OP0P1/P1.1 and OP0N1/P1.0 are OPA0 input pins.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OP1EN</name>
              <description>OPA1 enable bit</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable OPA1. OP1P/P2.2 and OP1N/P2.1 are GPIO mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable OPA1. OP1P/P2.2 and OP1N/P2.1 are OPA1 input pins.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPOEN</name>
              <description>OPA output enable bit</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable OPA output. OPO/P1.2 is GPIO mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable OPA output. OPO/P1.2 is OP-Amp output pin</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPAEN</name>
              <description>OPA enable bit</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable OPA. OP0P0/OP0N0/OP0P1/OP0N1/OP1P/OP1N/OPO is GPIO mode.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable OPA.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OPA_ADCCH</name>
              <description>OPA0/1 time-division multiplexing OPA function enable bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>The ADC does not sample OPAO but instead samples the general AIN channel.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>The ADC samples the differential signal of the OPAO.</description>
