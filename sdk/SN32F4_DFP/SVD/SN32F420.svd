                <enumeratedValue>
                  <name>Inverse2</name>
                  <description>MT16Bn_PWM1N pin outputs the inverse signal with dead-band of MT16Bn_PWM0, but same Low signal during dead-band period</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Same</name>
