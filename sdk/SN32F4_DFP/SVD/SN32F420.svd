          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>
          
          <fields>
            <field>
              <name>CTM</name>
              <description>Counter/Timer Mode</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Timer Mode</name>
                  <description>Timer Mode: every rising PCLK edge</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 1</name>
                  <description>TC is incremented on rising edges on the CAP0_SIG</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 2</name>
                  <description>TC is incremented on falling edges on the CAP0_SIG</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 3</name>
                  <description>TC is incremented on both edges on the CAP0_SIG</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 4</name>
                  <description>TC is incremented on rising edges on the CAP1_SIG</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 5</name>
                  <description>TC is incremented on falling edges on the CAP1_SIG</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Counter Mode 6</name>
                  <description>TC is incremented on both edges on the CAP1_SIG</description>
                  <value>6</value>
