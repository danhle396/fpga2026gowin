            </field>
            <field>
              <name>CAP1_SRC</name>
              <description>Signal source of capture event</description>
              <bitRange>[15:13]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CAP0_F</name>
                  <description>Select the CAP0_F as signal source of CAP1_SIG</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAP1_F</name>
                  <description>Select the CAP1_F as signal source of CAP1_SIG</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CAP_XOR</name>
                  <description>Select  CAP0_F XOR CAP1_F as signal source of CAP1_SIG</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMP0 OUT</name>
                  <description>Select  CMP0 OUT as signal source of CAP1_SIG</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CMP1 OUT</name>
                  <description>Select  CMP1 OUT as signal source of CAP1_SIG</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLT</name>
              <description>Filter width setting for CAP0/1 signal </description>
              <bitRange>[31:24]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_UT16B0_CAP0 -->
        <register>
          <name>CAP0</name>
          <description>Offset:0x2C UT16Bn CAP0 register</description>
          <addressOffset>0x2C</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>CAP0</name>
