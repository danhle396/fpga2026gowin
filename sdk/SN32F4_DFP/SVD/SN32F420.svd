                </enumeratedValue>
                <enumeratedValue>
                  <name>All empty</name>
                  <description>TX all empty triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
