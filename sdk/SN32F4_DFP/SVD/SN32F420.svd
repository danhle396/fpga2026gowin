    <!-- SN_DMA0 -->
    <peripheral>
      <name>SN_DMA0</name>
      <version>1.0</version>
      <description>Direct Memory Access</description>
      <groupName>DMA</groupName>
      <baseAddress>0x40072000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>DMA0</name>
        <description>Direct Memory Access</description>
        <value>1</value>
      </interrupt>
      
      <registers>
        <!-- SN_DMA0_INT -->
        <register>
          <name>INT</name>
          <description>Offset:0x00 DMA0 Interrupt Status register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000000F</resetMask>
          
          <fields>
            <field>
              <name>INT0</name>
              <description>The result of INT_ABT0 | INT_ERR0 | INT_TC0</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>Channel 0 has no pending interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 0 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INT1</name>
              <description>The result of INT_ABT1 | INT_ERR1 | INT_TC1</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>Channel 1 has no pending interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 1 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INT2</name>
              <description>The result of INT_ABT2 | INT_ERR2 | INT_TC2</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>Channel 2 has no pending interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 2 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INT3</name>
              <description>The result of INT_ABT3 | INT_ERR3 | INT_TC3</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>Channel 3 has no pending interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Yes</name>
                  <description>Channel 3 has a pending interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
