            </field>
            <field>
              <name>CMPFT</name>
              <description>CMP fast comparison enable bit</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Low Power mode</description>
                  <value>0</value>
