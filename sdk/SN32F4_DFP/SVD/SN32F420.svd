                  <description>No TXFIFOTH interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met</name>
                  <description>TX FIFO threshold is triggered when TXFIFOTHIE=1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TXUDFIF</name>
