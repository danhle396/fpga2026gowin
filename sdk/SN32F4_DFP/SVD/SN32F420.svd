        <!-- SN_MT16B0_RIS -->
        <register>
          <name>RIS</name>
          <description>Offset:0x38 MT16Bn Raw Interrupt Status register</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x800000EF</resetMask>
          
          <fields>
            <field>
              <name>MR0IF</name>
              <description>Match channel 0 interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR1IF</name>
              <description>Match channel 1 interrupt flag</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR2IF</name>
              <description>Match channel 2 interrupt flag</description>
              <bitRange>[2:2]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR3IF</name>
              <description>Match channel 3 interrupt flag</description>
              <bitRange>[3:3]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 3</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 3</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR9IF</name>
              <description>Match channel 9 interrupt flag</description>
              <bitRange>[5:5]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 9</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 9</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCMR0IF</name>
              <description>Match value for ADC triggered 0 interrupt flag</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match value for ADC triggered 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match value for ADC triggered 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ADCMR1IF</name>
              <description>Match value for ADC triggered 1 interrupt flag</description>
              <bitRange>[7:7]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match value for ADC triggered 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match value for ADC triggered 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKIF</name>
              <description>Break interrupt flag</description>
              <bitRange>[31:31]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No break condition occurs</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Break condition occurs</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
