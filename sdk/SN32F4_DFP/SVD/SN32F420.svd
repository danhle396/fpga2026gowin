                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM3 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM3 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0IOEN</name>
              <description>MT16Bn_PWM0/GPIO selection</description>
