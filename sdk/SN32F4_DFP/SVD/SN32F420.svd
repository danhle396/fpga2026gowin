                  <description>Decrement source address</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>Fixed source address</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Increment cyclic mode</description>
                  <value>3</value>
