    <!-- SN_PMU -->
    <peripheral>
      <name>SN_PMU</name>
      <version>1.0</version>
      <description>Power Management Unit</description>
      <groupName>PMU</groupName>
      <baseAddress>0x40032000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_PMU_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x40 PMU Control register</description>
          <addressOffset>0x40</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000007</resetMask>
          
          <fields>
            <field>
              <name>MODE</name>
              <description>Low Power mode selection</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Normal</name>
                  <description>Normal mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Deep-sleep mode</name>
                  <description>WFI instruction will make MCU enter Deep-sleep mode</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Sleep mode</name>
                  <description>WFI instruction will make MCU enter Sleep mode</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_CRC -->
    <peripheral>
      <name>SN_CRC</name>
      <version>1.0</version>
      <description>Cyclic Redundancy Check</description>
      <groupName>CRC</groupName>
      <baseAddress>0x40038000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <registers>
        <!-- SN_CRC_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x0 CRC Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000003F</resetMask>
          
          <fields>
            <field>
              <name>CRC</name>
              <description>CRC Polynomial</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CRC-16-CCITT</name>
                  <description>CRC-16-CCITT Polynomial</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CRC-16</name>
                  <description>CRC-16 Polynomial</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CRC-32</name>
                  <description>CRC-32 Polynomial</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RESET</name>
              <description>CRC Reset bit</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Reset</name>
                  <description>Reset CRC circuit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>URCRCEN</name>
              <description>CRC calculation for the User ROM enable bit</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop/Finish</name>
                  <description>Stop/Finish CRC calculation</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Start CRC calculation for the User ROM</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BUSY</name>
              <description>CRC calculation busy flag</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Idle/Finish</name>
                  <description>CRC calculation idle/finished</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>CRC calculation is in process</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CRCRANGE</name>
              <description>CRC calculation range select bit</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Range 0</name>
                  <description>All User ROM, except the last page (0x00000000~0x00007DFF)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Range 1</name>
                  <description>All User ROM, except the last 2 pages (0x00000000~0x00007BFF)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_CRC_DATA -->
        <register>
          <name>DATA</name>
          <description>Offset:0x4 CRC Data register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DATA</name>
              <description>CRC Data</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
