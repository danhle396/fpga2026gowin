                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse1</name>
                  <description>MT16Bn_PWM0N pin outputs the inverse signal with dead-band of MT16Bn_PWM0, but same High signal during dead-band period</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Inverse2</name>
                  <description>MT16Bn_PWM0N pin outputs the inverse signal with dead-band of MT16Bn_PWM0, but same Low signal during dead-band period</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Same</name>
                  <description>MT16Bn_PWM0N pin outputs the same signal with dead-band of MT16Bn_PWM0</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1NIOEN</name>
