              <enumeratedValues>
                <enumeratedValue>
                  <name>DAC</name>
                  <description>DAC. CM0P0/CM0P1/CM0P2 pins are GPIO mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P0</name>
                  <description>CM0P0 is positive input pin</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P1</name>
                  <description>CM0P1 is positive input pin</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM0P2</name>
