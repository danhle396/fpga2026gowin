              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_REM -->
        <register>
          <name>DIV_REM</name>
          <description>Offset:0x18 ACC Reminder Output of Division register</description>
          <addressOffset>0x18</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_REM</name>
              <description>Reminder output of division in signed 16-bit format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_SQRT_IN -->
        <register>
          <name>SQRT_IN</name>
          <description>Offset:0x1C ACC Square Root Input register</description>
          <addressOffset>0x1C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>SQRT_IN</name>
              <description>Square root input value in unsigned 32-bit format</description>
              <bitRange>[31:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_SQRT_OUT -->
        <register>
          <name>SQRT_OUT</name>
          <description>Offset:0x20 ACC Square Root Output register</description>
          <addressOffset>0x20</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x0000FFFF</resetMask>
          
          <fields>
            <field>
              <name>SQRT_OUT</name>
              <description>Square root output value in unsigned 16-bit format</description>
              <bitRange>[15:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_HALL -->
    <peripheral>
      <name>SN_HALL</name>
      <version>1.0</version>
      <description>Hall Sensor Interface Function</description>
      <groupName>HALL</groupName>
      <baseAddress>0x40078000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>HALL</name>
        <description>HALL interrupt</description>
        <value>22</value>
      </interrupt>
      
      <registers>
        <!-- SN_HALL_CFG -->
        <register>
          <name>CFG</name>
          <description>Offset:0x00 HALL Configuration register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x77137FFF</resetMask>
          
          <fields>
            <field>
              <name>FLT_LENGTH</name>
              <description>The legth of second stage continuous filter. </description>
              <bitRange>[14:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>CLK_DIV</name>
              <description>Hall sensor module clock source divider</description>
              <bitRange>[17:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>HCLK/1</name>
                  <description>Hall sensor module clock source divider = 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HCLK/2</name>
                  <description>Hall sensor module clock source divider = 2</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HCLK/4</name>
                  <description>Hall sensor module clock source divider = 4</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HCLK/8</name>
                  <description>Hall sensor module clock source divider = 8</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FLT_75_EN</name>
              <description>7-out-of-5 filtering enable bit</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable 7-out-of-5 filtering</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable 7-out-of-5 filtering</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HALL_EN</name>
              <description>HALL Module enable bit</description>
              <bitRange>[24:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL Module</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL Module</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA_CHG</name>
              <description>HALL signal change DMA request active enable</description>
              <bitRange>[25:25]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL signal change DMA request active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL signal change DMA request active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA_OV</name>
              <description>HALL Counter overflow DMA request active enable</description>
              <bitRange>[26:26]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL Counter overflow DMA request active</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL Counter overflow DMA request active</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHGIE</name>
              <description>HALL signal change interrupt enable</description>
              <bitRange>[28:28]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL signal change interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL signal change interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OVIE</name>
              <description>HALL signal overflow interrupt enable</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL signal overflow interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL signal overflow interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWIE</name>
              <description>HALL signal SW trigger interrupt enable</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable HALL signal SW trigger interrupt </description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable HALL signal SW trigger interrupt </description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_HALL_INFO -->
        <register>
          <name>INFO</name>
          <description>Offset:0x04 HALL Information register</description>
          <addressOffset>0x04</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00070707</resetMask>
          
          <fields>
            <field>
              <name>FLT_DATA</name>
              <description>HALL sensor signal value after filter</description>
              <bitRange>[2:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>RAW_DATA</name>
              <description>HALL sensor signal value before filter</description>
              <bitRange>[10:8]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>CHGIF</name>
              <description>HALL signal change interrupt flag</description>
              <bitRange>[16:16]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt requirement met</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met</name>
                  <description>Interrupt requirements(Hall signal change) met</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>OVIF</name>
              <description>HALL signal overflow interrupt flag</description>
              <bitRange>[17:17]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt requirement met</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met</name>
                  <description>Interrupt requirements(Counter match HALL_TH) met</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SWIF</name>
              <description>HALL signal SW interrupt trigger.</description>
              <bitRange>[18:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>None</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met</name>
                  <description>Write 1 to trigger HALL signal(SW)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_HALL_WIDTH -->
        <register>
          <name>WIDTH</name>
          <description>Offset:0x08 HALL Counter Width register</description>
          <addressOffset>0x08</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>CAP_INT</name>
              <description>The capture width value of the HALL sensor signal Counter</description>
              <bitRange>[23:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_HALL_TH -->
        <register>
          <name>TH</name>
          <description>Offset:0x0C HALL Counter Threshold register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>TH</name>
              <description>The threshold value of the HALL sensor signal Counter</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
        <!-- SN_HALL_CNT -->
        <register>
          <name>CNT</name>
          <description>Offset:0x10 HALL Counter register</description>
          <addressOffset>0x10</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00FFFFFF</resetMask>
          
          <fields>
            <field>
              <name>CNT</name>
              <description>The current value of the HALL sensor signal Counter</description>
              <bitRange>[23:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        
      </registers>
    </peripheral>
    
    <!-- SN_UART1 -->
    <peripheral derivedFrom="SN_UART0">
      <name>SN_UART1</name>
      <baseAddress>0x40056000</baseAddress>
      
      <interrupt>
        <name>UART1</name>
        <description>UART1 interrupt</description>
        <value>14</value>
      </interrupt>
    </peripheral>
    
    <!-- SN_UT16B1 -->
    <peripheral derivedFrom="SN_UT16B0">
      <name>SN_UT16B1</name>
      <baseAddress>0x40004000</baseAddress>
      
      <interrupt>
        <name>UT16B1</name>
        <description>16-bit Timer 1 with General Capture function</description>
        <value>21</value>
      </interrupt>
    </peripheral>
    
  </peripherals>
</device>