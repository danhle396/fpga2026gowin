            </field>
          </fields>
        </register>
        
        <!-- SN_UT16B0_DMA -->
        <register>
          <name>DMA</name>
          <description>Offset:0xD0 UT16Bn DMA mode register</description>
          <addressOffset>0xD0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000073</resetMask>
          
          <fields>
            <field>
              <name>DMA_MR0</name>
              <description>MR0 DMA request active enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable. MR0 DMA request cannot issue.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable. MR0 DMA request can issue.</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DMA_MR1</name>
              <description>MR1 DMA request active enable</description>
