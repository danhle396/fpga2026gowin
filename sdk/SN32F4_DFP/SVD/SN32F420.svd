                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable CM1O</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1G</name>
              <description>CMP1 interrupt trigger direction control bit</description>
              <bitRange>[29:29]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Falling range trigger</name>
                  <description>CMP1 output status is from high to low as V+ is less than V-</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Rising edge trigger</name>
                  <description>CMP1 output status is from low to high as V+ is more than V-</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CMPHYS</name>
