              <bitRange>[20:19]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Full-duplex, 2-line unidirectional data mode</name>
                  <description>Full-duplex, 2-line unidirectional data mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Half-duplex, 1-line unidirectional data mode(RX)</name>
                  <description>Half-duplex, 1-line unidirectional data mode (receive-only mode)</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Half-duplex, 1-line unidirectional data mode(TX)</name>
                  <description>Half-duplex, 1-line unidirectional data mode (transmit-only mode)</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_SPI0_CTRL1 -->
