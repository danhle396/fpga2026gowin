    <!-- SN_ACC -->
    <peripheral>
      <name>SN_ACC</name>
      <version>1.0</version>
      <description>Atan, Div and Sqrt Function</description>
      <groupName>ACC</groupName>
      <baseAddress>0x40076000</baseAddress>
      <size>32</size>
      <access>read-write</access>
      
      <addressBlock>
        <offset>0</offset>
        <size>0x2000</size>
        <usage>registers</usage>
      </addressBlock>
      
      <interrupt>
        <name>SQRT</name>
        <description>SQRT interrupt</description>
        <value>17</value>
      </interrupt>
      
      <interrupt>
        <name>DIV</name>
        <description>DIV interrupt</description>
        <value>20</value>
      </interrupt>
      
      <registers>
        <!-- SN_ACC_CTRL -->
        <register>
          <name>CTRL</name>
          <description>Offset:0x00 ACC Hardware Calculation Accelerator Control register</description>
          <addressOffset>0x00</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x000007E3</resetMask>
          
          <fields>
            <field>
              <name>ACC_EN</name>
              <description>Hardware calculation accelerator enable bit</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable the hardware accelerator</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable the hardware accelerator</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>IE</name>
              <description>Hardware calculation accelerator interrupt enable bit</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable ACC interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable ACC interrupt</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_START_PULSE</name>
              <description>Division operation trigger bit</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>Trigger 1 pulse to start DIV operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_RDY</name>
              <description>Division ready status</description>
              <bitRange>[6:6]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>DIV is operating</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>DIV is not operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DIV_INT</name>
              <description>Division interrupt signal</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No DIV interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Meet</name>
                  <description>DIV interrupt is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_START_PULSE</name>
              <description>Square root operation trigger bit</description>
              <bitRange>[8:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No action</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Trigger</name>
                  <description>Trigger 1 pulse to start SRQT operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_RDY</name>
              <description>Square root ready status</description>
              <bitRange>[9:9]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Busy</name>
                  <description>SQRT is operating</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Idle</name>
                  <description>SQRT is not operating</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SQRT_INT</name>
              <description>Square root interrupt signal</description>
              <bitRange>[10:10]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>None</name>
                  <description>No SQRT interrupt</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Meet</name>
                  <description>SQRT interrupt is triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_ACC_DIV_DVD -->
        <register>
          <name>DIV_DVD</name>
          <description>Offset:0x0C ACC Dividend Input for Division register</description>
          <addressOffset>0x0C</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0xFFFFFFFF</resetMask>
          
          <fields>
            <field>
              <name>DIV_DVD</name>
              <description>Dividend input for division in signed 32-bit format</description>
              <bitRange>[31:0]</bitRange>
