              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM3 is 0 when TC is less than MR3.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM3 is 1 when TC is less than MR3.</description>
                  <value>1</value>
