              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UT16B0_DMAMRA1 -->
        <register>
          <name>DMAMRA1</name>
          <description>Offset:0xD4 UT16Bn DMA MR Alias register 1</description>
          <addressOffset>0xD4</addressOffset>
