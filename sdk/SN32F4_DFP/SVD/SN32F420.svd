        <!-- SN_MT16B0_BRKCTRL -->
        <register>
          <name>BRKCTRL</name>
          <description>Offset:0xE0 MT16Bn Break Function Control register</description>
          <addressOffset>0xE0</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x4000007F</resetMask>
          
          <fields>
            <field>
              <name>BRKSEL</name>
              <description>The trigger source selection of PWM channels break function</description>
              <bitRange>[2:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>000b</name>
                  <description>Disable</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>CMP0 output</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>CMP1 output</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>Break pin (BRK)</description>
                  <value>4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKLEVEL</name>
              <description>The trigger level of PWM channels break function</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>0b</name>
                  <description>Low level.  (CMP V- > V+)</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1b</name>
                  <description>High level. (CMP V+ > V-)</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKDB</name>
              <description>Break pin (BRK) debounce time</description>
              <bitRange>[6:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>1T</name>
                  <description>Debounce time=1*MT16B0_PCLK</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>2T</name>
                  <description>Debounce time=2*MT16B0_PCLK</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>4T</name>
                  <description>Debounce time=4*MT16B0_PCLK</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>8T</name>
                  <description>Debounce time=8*MT16B0_PCLK</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>16T</name>
                  <description>Debounce time=16*MT16B0_PCLK</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>32T</name>
                  <description>Debounce time=32*MT16B0_PCLK</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>64T</name>
                  <description>Debounce time=64*MT16B0_PCLK</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>128T</name>
                  <description>Debounce time=128*MT16B0_PCLK</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BRKIE</name>
              <description>Enable generating an interrupt when BRKIF = 1</description>
              <bitRange>[30:30]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable generating an interrup</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Generating an interrupt when BRKIF = 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
