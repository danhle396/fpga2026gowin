              <bitRange>[9:8]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>Transfer width is 8 bits</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Transfer width is 16 bits</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
