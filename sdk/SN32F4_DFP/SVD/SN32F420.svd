        <!-- SN_UT16B0_PWMCTRL -->
        <register>
          <name>PWMCTRL</name>
          <description>Offset:0x34 UT16Bn PWM Control register</description>
          <addressOffset>0x34</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x803000F3</resetMask>
          
          <fields>
            <field>
              <name>PWM0EN</name>
              <description>PWM0 enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable PWM mode for UT16Bn_PWM0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for UT16Bn_PWM0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1EN</name>
              <description>PWM1 enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable PWM mode for UT16Bn_PWM1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for UT16Bn_PWM1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0MODE</name>
              <description>PWM0 output mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM0 is 0 when TC is less than MR0.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM0 is 1 when TC is less than MR0.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM0 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM0 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1MODE</name>
              <description>PWM1 output mode</description>
              <bitRange>[7:6]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PWM mode 1</name>
                  <description>During up-counting, PWM1 is 0 when TC is less than MR1.</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PWM mode 2</name>
                  <description>During up-counting, PWM1 is 1 when TC is less than MR1.</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 0</name>
                  <description>PWM1 is forced to 0</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Force 1</name>
                  <description>PWM1 is forced to 1</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0IOEN</name>
              <description>UT16Bn_PWM0/GPIO selection</description>
              <bitRange>[20:20]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>UT16Bn_PWM0 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>UT16Bn_PWM0 pin act as match output, and output depends on PWM0EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM1IOEN</name>
              <description>UT16Bn_PWM1/GPIO selection</description>
              <bitRange>[21:21]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>UT16Bn_PWM1 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>UT16Bn_PWM1 pin act as match output, and output depends on PWM1EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ONETRIG</name>
              <description>One trigger mode</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable one trigger mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable one trigger mode</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_UT16B0_RIS -->
        <register>
          <name>RIS</name>
          <description>Offset:0x38 UT16Bn Raw Interrupt Status register</description>
          <addressOffset>0x38</addressOffset>
          <size>32</size>
          <access>read-only</access>
          <resetValue>0x00000000</resetValue>
          <resetMask>0x00000073</resetMask>
          
          <fields>
            <field>
              <name>MR0IF</name>
              <description>Match channel 0 interrupt flag</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>No</name>
                  <description>No interrupt on match channel 0</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Met interrupt requirements</name>
                  <description>Interrupt requirements met on match channel 0</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MR1IF</name>
              <description>Match channel 1 interrupt flag</description>
