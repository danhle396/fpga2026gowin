                  <description>Burst size = 1</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>001b</name>
                  <description>Burst size = 4</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>010b</name>
                  <description>Burst size = 8</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>011b</name>
                  <description>Burst size = 16</description>
                  <value>3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>100b</name>
                  <description>Burst size = 32</description>
                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>101b</name>
                  <description>Burst size = 64</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>110b</name>
                  <description>Burst size = 128</description>
                  <value>6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>111b</name>
                  <description>Burst size = 256</description>
                  <value>7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CHPRI</name>
              <description>Channel priority level</description>
              <bitRange>[23:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>0: Lowest priority</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>1: 3rd high priority</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>2: 2nd high priority</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>3: Highest priority</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>TC_MSK</name>
              <description>Terminal count status mask for current transaction</description>
              <bitRange>[31:31]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>When terminal count happens, TC status register will be set</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>When terminal count happens, TC status register will not be set</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        
        <!-- SN_DMA0_C0_CFG -->
