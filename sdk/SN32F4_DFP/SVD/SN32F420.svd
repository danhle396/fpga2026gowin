        <!-- SN_MT16B0_LOADCTRL -->
        <register>
          <name>LOADCTRL</name>
          <description>Offset:0x74 MT16Bn PWM Load Mode Control register</description>
          <addressOffset>0x74</addressOffset>
          <size>32</size>
          <access>read-write</access>
          <resetValue>0x00000555</resetValue>
          <resetMask>0x00000FFF</resetMask>
          
          <fields>
            <field>
              <name>LOAD_MR0</name>
              <description>MR0 load mode selection in center-aligned mode</description>
              <bitRange>[1:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Load MR0 value at TC=0 and MR0 value is unchanged at TC=MR9</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>MR0 value is unchanged at TC=0 and Load MR0 value at TC=MR9</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Load MR0 value at TC=0 and TC=MR9</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOAD_MR1</name>
              <description>MR1 load mode selection in center-aligned mode</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Load MR1 value at TC=0 and MR1 value is unchanged at TC=MR9</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>MR1 value is unchanged at TC=0 and Load MR1 value at TC=MR9</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Load MR1 value at TC=0 and TC=MR9</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOAD_MR2</name>
              <description>MR2 load mode selection in center-aligned mode</description>
              <bitRange>[5:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>00b</name>
                  <description>No effect</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>01b</name>
                  <description>Load MR2 value at TC=0 and MR2 value is unchanged at TC=MR9</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>10b</name>
                  <description>MR2 value is unchanged at TC=0 and Load MR0 value at TC=MR9</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>11b</name>
                  <description>Load MR2 value at TC=0 and TC=MR9</description>
                  <value>3</value>
