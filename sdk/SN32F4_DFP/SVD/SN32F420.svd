                  <description>CM1N0 is negative input pin</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM1N1</name>
                  <description>CM1N1 is negative input pin</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CM1N2</name>
                  <description>CM1N2 is negative input pin</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DAC</name>
                  <description>DAC. CM1N0/CM1N1/CM1N2 pins are GPIO mode</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CM1OEN</name>
