              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>Disable PWM mode for MT16Bn_PWM2</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>Enable PWM mode for MT16Bn_PWM2</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3EN</name>
