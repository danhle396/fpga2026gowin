                <enumeratedValue>
                  <name>1101</name>
                  <description>Data length=14</description>
                  <value>13</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1110</name>
                  <description>Data length=15</description>
                  <value>14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>1111</name>
                  <description>Data length=16</description>
                  <value>15</value>
                </enumeratedValue>
