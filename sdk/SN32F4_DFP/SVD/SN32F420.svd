                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>MT16Bn_PWM1 pin act as match output, and output depends on PWM1EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM2IOEN</name>
              <description>MT16Bn_PWM2/GPIO selection</description>
              <bitRange>[22:22]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>MT16Bn_PWM2 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>MT16Bn_PWM2 pin act as match output, and output depends on PWM2EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM3IOEN</name>
              <description>MT16Bn_PWM3/GPIO selection</description>
              <bitRange>[23:23]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disable</name>
                  <description>MT16Bn_PWM3 pin is act as GPIO</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enable</name>
                  <description>MT16Bn_PWM3 pin act as match output, and output depends on PWM3EN bit</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>PWM0NIOEN</name>
              <description>MT16Bn_PWM0N/GPIO selection bit</description>
              <bitRange>[25:24]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
