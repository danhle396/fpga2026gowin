// Chân theo sơ đồ nối thực tế của nhóm (24/10, docs/bao_cao/2026-10-24_so_do_noi_nhom/): SPI trên header J2 của Kiwi,
// đúng 4 ball nhóm đã chạy thông SPI với ESP32. IRQ và RST_N trên J2-24 / J2-23 (bank 3, 3,3 V). Dò lại bằng rtl/pin_probe.
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "spi_cs_n" R11;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "spi_sclk" T14;
IO_PORT "spi_sclk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "spi_mosi" R13;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "spi_miso" R12;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "irq" R8;
IO_PORT "irq" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC "rst_n" T8;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
