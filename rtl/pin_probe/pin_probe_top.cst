// Dò 6 chân trên header J2 (sơ đồ nối 24/10): probe[0..5] = CS J2-16, SCK J2-10, MOSI J2-11, MISO J2-13, IRQ J2-24, RST_N J2-23
IO_LOC "clk" H11;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "probe[0]" R11;
IO_PORT "probe[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "probe[1]" T14;
IO_PORT "probe[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "probe[2]" R13;
IO_PORT "probe[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "probe[3]" R12;
IO_PORT "probe[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "probe[4]" R8;
IO_PORT "probe[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "probe[5]" T8;
IO_PORT "probe[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_LOC "led_n" D15;
IO_PORT "led_n" IO_TYPE=LVCMOS33 DRIVE=8;
