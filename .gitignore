# Sản phẩm build và mô phỏng: tái tạo bằng firmware/build.sh, Keil, fpga/scripts/*.sh
__pycache__/
*.vvp
firmware/build/
firmware/keil/Objects/
firmware/keil/Listings/
firmware/keil/*.uvguix.*
firmware/keil/build_log.txt
# project Gowin fpga/: chỉ giữ cấu hình, bỏ kết quả Run All của IDE
fpga/impl/*
!fpga/impl/fpga_project_process_config.json
fpga/*.gprj.user
# log ghi bằng tools/ghi_uart.py (dán nội dung vào chat, hoặc chép vào docs/bao_cao/ làm bằng chứng)
ket_qua_board/
# cấu hình Claude Code riêng từng máy
.claude/settings.local.json
# WiFi riêng của từng máy cho sketch ESP32
esp32/mu_nga_hub/wifi_rieng.h
